(document (TeXmacs "2.1.4")
  (style (tuple "generic" "chinese"))
  (body
    (document (chapter* "[6029] 清理 srfi-19，为升级 goldfish scheme v18.11.41 做准备")
      (section* "1 Why（背景）")
      (itemize (document
        (concat (item) "goldfish scheme v18.11.41 做了三件事：移除 (srfi srfi-19) 模块；(liii time) 收窄为仅导出 sleep；新增 (liii date-time format) 的 date-time-format（strftime 风格，默认 %Y-%m-%d %H:%M:%S，接受 timestamp/date/clock-time/moment），即 date->string 的官方替代。上游对应提交 6867e797 [1075]。")
        (concat (item) "以上结论均已用系统 gf 18.11.41 实测验证：import srfi-19 报 loading did not define the library；(liii time) 的 current-time/time-second 已 unbound；(import (liii date-time format)) 后 (date-time-format (current-system-timestamp) %Y%m%d_%H%M%S) 输出正常。")
        (concat (item) "mogan 仓库捆绑的仍是 v18.11.40（有 srfi-19），本次清理先迁移自有代码，升级 PR 再同步运行时，避免一次改动过大。")
        (concat (item) "(liii time) 本体属于 goldfish 仓库，不改，随 v18.11.41 升级带入 sleep-only 版本；但其 srfi-19 再导出的使用者属于 mogan，必须全部迁移。")
      ))
      (section* "2 What（迁移范围）")
      (subsection* "2.1 A 类：直接 import (srfi srfi-19)（3 个文件）")
      (itemize (document
        (concat (item) "TeXmacs/plugins/autosave/goldfish/liii/autosave.scm：autosave-target-path 用 current-date + date->string（~Y~m~d_~H~M~S）。")
        (concat (item) "TeXmacs/plugins/telemetry/progs/telemetry/telemetry-utils.scm：(only (srfi srfi-19) current-date date->string date-zone-offset)；telemetry-generate-filename（~Y~m~d-~H~M~S）、telemetry-timezone（date-zone-offset）。")
        (concat (item) "TeXmacs/plugins/telemetry/goldfish/tm-telemetry.scm：format-event-line 用 make-time/TIME-UTC/time-utc->date + date->string（~Y-~m-~d ~H:~M:~S）。")
      ))
      (subsection* "2.2 B 类：经 (liii time) 使用 srfi-19 再导出（5 个文件）")
      (itemize (document
        (concat (item) "TeXmacs/progs/texmacs/texmacs/tm-files.scm：(only (liii time) current-date date->string make-date date-week-day date->julian-day)；scratch-buffer-name（~Y~m~d_~H~M~S）、scratch-today（~Y~m~d）、day->date（make-date 8 参）、day-number（date->julian-day + floor +0.5）、scratch-buffer-title（date-week-day）。")
        (concat (item) "TeXmacs/progs/texmacs/texmacs/tm-files-test.scm：(only (liii time) current-date date->string)（~Y~m~d~H~M~S）。")
        (concat (item) "TeXmacs/progs/texmacs/texmacs/tm-print.scm：(only (liii time) current-date date->string)（~Y~m~d_~H~M~S）。")
        (concat (item) "TeXmacs/plugins/attachment/goldfish/tm-attachment.scm：current-date + date-year/date-month。")
        (concat (item) "TeXmacs/progs/kernel/texmacs/tm-dialogue.scm：(liii time) 整体 import，3 处 (time-second (current-time))。")
      ))
      (subsection* "2.3 排除与不受影响项")
      (itemize (document
        (concat (item) "TeXmacs/plugins/goldfish/goldfish/ 是上游仓库拷贝（srfi-19.scm 本体、srfi-27.scm、(liii time)），不改，随版本升级带入。")
        (concat (item) "裸用 (current-time) 的 progs（updater.scm、notificationbar.scm、version-update.scm、apidoc-collect.scm、tests/0205.scm 等）：符号来自 moebius/Scheme/S7/s7_tm.cpp 的 C 兼容层 initialize_compat 注册的 current-time（返回整数秒），与 srfi-19 无关，不受影响，已核实。")
        (concat (item) "TeXmacs/plugins/account/progs/account/liii.scm 的 get-current-time 对 (current-time) 结果取 car/cdr：C 内建返回整数，此处疑似既有缺陷或死代码，本次不迁移，仅在风险节登记。")
      ))
      (section* "3 How（API 映射，均已在 gf 18.11.41 实测）")
      (itemize (document
        (concat (item) "(current-date) -> (current-system-timestamp)：同为系统本地时区，语义一致。【v18.11.40 可用】")
        (concat (item) "date-year/date-month(date 对象) -> timestamp-year/timestamp-month(timestamp 对象)：attachment 场景实测 (2026 10 25)。【v18.11.40 可用】")
        (concat (item) "(date-zone-offset (current-date)) -> (timestamp-timezone-offset (current-system-timestamp))：返回值从秒数整数变为 time-delta，用 time-delta-hours/time-delta-minutes 提取，判零改为二者同时 zero?。【v18.11.40 可用】")
        (concat (item) "(time-utc->date (make-time TIME-UTC 0 sec)) -> (timestamp-in-timezone (posix-time->utc-timestamp sec) (system-timezone))：要求 exact 有理数，先 inexact->exact (truncate ...)。【v18.11.40 可用】")
        (concat (item) "(make-date ns sec min hour day mon year zone) -> (make-date year month day)：签名从 8 变 3，day->date 重排实参。【v18.11.40 可用】")
        (concat (item) "julian-day 逻辑整段删除，不保留等价换算：day-number 唯一服务 draft-this-week? 的周分组，改用 date->rata-die 直接分组——rata-die 历元 0001-01-01 恰为周一，两日期 quotient (rd - 1) 7 商相同即同属一个周一起算的自然周；scratch-today 缓存的 cdr 由 day-number 换成今天的 rata-die，draft-this-week? 相应改商式。与旧实现分组等价（旧 bucket 为 quotient (rd + 1721425) 7，1721426 可被 7 整除，两套分界同为周一对齐）。实测另发现上游 date-iso-week 存在周日并入下一周的 off-by-one 缺陷（与 ISO 8601 周一开周不符，上游无测试覆盖），故不采用它做周分组，建议向上游反馈。【v18.11.40 可用】")
        (concat (item) "date-week-day（周日为 0）-> (modulo (date-iso-weekday d) 7)（ISO 周一为 1..周日为 7，实测周日 -> 0），scratch-weekdays 向量与注释不动。【v18.11.40 可用】")
        (concat (item) "(time-second (current-time)) -> (current-time)：去掉 (liii time) import 后裸 current-time 即 C 兼容层内建，本就返回整数秒，两版本行为一致。【v18.11.40 可用】")
        (concat (item) "(date->string d ~格式) -> (date-time-format ts %格式)：~Y~m~d_~H~M~S -> %Y%m%d_%H%M%S、~Y~m~d~H~M~S -> %Y%m%d%H%M%S、~Y~m~d-~H~M~S -> %Y%m%d-%H%M%S、~Y-~m-~d ~H:~M:~S -> %Y-%m-%d %H:%M:%S、~Y~m~d -> %Y%m%d；date 对象与 timestamp 对象均可。【需 v18.11.41，本次暂不做】")
      ))
      (section* "4 实施计划（两阶段）")
      (subsection* "4.1 阶段一：本次（基于 v18.11.40）")
      (itemize (document
        (concat (item) "A 类 3 文件与 B 类 5 文件按第 3 节 v18.11.40 可用项迁移：current-date、date-zone-offset、make-time/time-utc->date、make-date、rata-die 周分组、date-week-day、time-second。")
        (concat (item) "date->string 共 7 处（autosave、telemetry-utils、tm-telemetry、tm-files 两处、tm-files-test、tm-print）暂时保留：替代函数不在 v18.11.40，不手写临时轮子避免二次改动；对应 import 收窄为 (only (liii time) date->string) 或 (only (srfi srfi-19) date->string)。")
        (concat (item) "tm-dialogue.scm 去掉 (liii time) import，3 处 (time-second (current-time)) 直接换 (current-time)。")
        (concat (item) "tm-attachment.scm 的 (liii time) import 换 (liii date-time)，date-year/date-month 换 timestamp-year/timestamp-month。")
        (concat (item) "tm-files.scm 删除 day-number/julian-day 相关定义与注释，draft-this-week? 按 rata-die 周分组改写（见第 3 节）；scratch-buffer-title 的星期名改用 (modulo (date-iso-weekday d) 7) 索引 scratch-weekdays。")
      ))
      (subsection* "4.2 阶段二：随 v18.11.41 升级 PR")
      (itemize (document
        (concat (item) "同步上游 goldfish v18.11.41 到 plugins/goldfish/goldfish/（srfi-19 移除、liii time 收窄、date-time format 就位）。")
        (concat (item) "7 处 date->string 换 date-time-format，删除全部残留 srfi-19 import。")
        (concat (item) "全仓 grep 验证（排除 plugins/goldfish/goldfish/）：srfi-19 无引用；time-second/make-date 旧签名/date->julian-day 等 srfi-19 专属 API 无残留。")
        (concat (item) "回归第 6 节风险项：account 插件 current-time 取 car/cdr 的既有缺陷一并确认处理。")
      ))
      (section* "5 测试")
      (itemize (document
        (concat (item) "tm-files-test.scm 现成单测回归：xmake b stem && xmake r tm-files-test（覆盖 scratch-buffer-name/scratch-today/draft-this-week?/scratch-buffer-title）。")
        (concat (item) "autosave：cd TeXmacs/plugins/autosave/goldfish && goldfish tests/autosave-prune-test.scm；可补 autosave-target-path 文件名形态断言（YYYYMMDD_HHMMSS.tmu，不依赖具体时刻）。")
        (concat (item) "telemetry：无现成测试；gf 临时脚本验证 telemetry-timezone 返回 +08:00 形态、telemetry-generate-filename 前缀 detail-telemetry-YYYYMMDD-HHMMSS-。")
        (concat (item) "tm-telemetry：构造含 timestamp 的 jsonl 走插件协议，验证日志时间为本地 YYYY-MM-DD HH:MM:SS。")
        (concat (item) "等价性抽查：迁移前后 draft-this-week? 对同一批日期（含周日、周六、跨年周界如 2024-12-30 与 2025-01-01 同属 2025-W01、闰日 2024-02-29）判定一致；可先在 v18.11.40 下用旧实现跑出基准表，再对新实现断言；tm-files-test.scm 补跨周界固定日期用例（现行测试只覆盖今年非本周/往年档位）。")
        (concat (item) "提交前 gf fmt --changed-since=main。")
      ))
      (section* "6 风险与备注")
      (itemize (document
        (concat (item) "上游 date-iso-week 周日 off-by-one 缺陷（周日并入下一周，与 ISO 8601 不符；上游仅 date-iso-weekday 有测试）：本次不采用该函数，建议单独向上游 goldfish 报告修复；修复前 mogan 内不用它做周分组。")
        (concat (item) "周分组语义等价已验证：旧 julian-day 与新 rata-die 两套分界同为周一对齐（1721426 ≡ 0 mod 7），分组逐日等价，draft 标题档位判定不变；仍以第 5 节日期抽查兜底。")
        (concat (item) "时区语义：srfi-19 current-date 为本地时区，current-system-timestamp 基于 system-timezone，一致；date->string 打本地时间，date-time-format 打时间戳自身时区（system timestamp 即本地），一致。")
        (concat (item) "秒的小数：timestamp-second 可能为含纳秒有理数，date-time-format 的 %S 输出行为在阶段二升级时实测确认（上游 format-util 有 pad-zero/read-microsecond 处理）。")
        (concat (item) "account 插件 liii.scm get-current-time 的 (car (current-time)) 与 C 内建返回整数不符，疑似既有缺陷或死代码，本次不动，阶段二确认。")
        (concat (item) "srfi-27.scm（random）依赖 srfi-19，属上游 goldfish 自身，v18.11.41 已随移除适配，mogan 无需处理。")
      ))
    ) ;document
  ) ;body
) ;document
