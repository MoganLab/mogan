(document (TeXmacs "2.1.4") (style (tuple "generic" "chinese" "table-captions-above" "number-europe" "preview-ref")) (body (document (concat (with "font-series" "bold" "任务编号") "：6201") (concat (with "font-series" "bold" "任务内容") "：") "1.修复AI侧边栏中，在dark模式下，AI回复内容时会不断白屏闪烁的问题。" "    参考修复方向：渲染器的初始底色的设置问题" (concat (with "font-series" "bold" "注意事项") "：") "1、构建采用非社区版（is_community=n)" (concat "2、提交的pr的标题、正文，参考09开头编号的pr，比如：" (hlink "[1601] 修复释义引文1（上下文）的半截 herk 与段落内容丢失，上下文预算拉齐 by PinkMagicFly <centerdot> Pull Request #4627 <centerdot> MoganLab/mogan" "https://github.com/MoganLab/mogan/pull/4627")) "3、devel里惯例要写的任务文档，追加在本文件中。" "" "验收标准：" "      检验文字：无" "  ")) (initial (collection (associate "page-medium" "paper") (associate "page-screen-margin" "false") (associate "save-aux" "false") (associate "stem-doc-id" "D98B97F0-1D3E-4060-8A5D-EC3C5C6800D0"))))