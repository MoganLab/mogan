" "1" "2" "cell-tborder" "1ln") (cwith "1" "1" "1" "2" "cell-bborder" "1ln") (cwith "2" "2" "1" "2" "cell-tborder" "1ln") (cwith "1" "1" "1" "1" "cell-lborder" "0ln") (cwith "1" "1" "2" "2" "cell-rborder" "0ln") (cwith "6" "6" "1" "2" "cell-tborder" "0ln") (cwith "5" "5" "1" "2" "cell-bborder" "0ln") (cwith "6" "6" "1" "2" "cell-bborder" "1ln") (cwith "6" "6" "1" "1" "cell-lborder" "0ln") (cwith "6" "6" "2" "2" "cell-rborder" "0ln") (cwith "1" "1" "1" "2" "cell-height" "2em") (cwith "1" "1" "1" "2" "cell-vmode" "exact") (cwith "2" "6" "1" "2" "cell-height" "2em") (cwith "2" "6" "1" "2" "cell-vmode" "exact") (cwith "1" "6" "1" "2" "cell-valign" "c") (table (row (cell "文件名") (cell "描述")) (row (cell "thuthesis.dtx") (cell "模板的源文件，包括文档和注释")) (row (cell "thuthesis.cls") (cell "模板文件")) (row (cell "thuthesis-*.bst") (cell "BibTeX 参考文献表样式文件")) (row (cell "thuthesis-*.bbx") (cell "BibLaTeX 参考文献表样式文件")) (row (cell "thuthesis-*.cbx") (cell "BibLaTeX 引用样式文件")))))) (cell ""))))) (label "table:2-4")) "旋转90度的三线表示例"))))) (initial (collection (associate "page-medium" "paper") (associate "page-screen-margin" "false") (associate "save-aux" "false") (associate "stem-doc-id" "A43F084F-B1D4-4C10-81F9-4772827DFA40"))))