(document (TeXmacs "2.1.4") (style (tuple "generic" "chinese" "table-captions-above" "number-europe" "preview-ref")) (body (document (concat (with "font-series" "bold" "任务编号") "：6200") (concat (with "font-series" "bold" "任务内容") "：") "1.修复引用块(插入-外观块-引用)中，表格内容会超过范围，没有正确换行的问题。" (with "par-mode" "center" (image (tuple (raw-data "") "png") "0.8par" "0.436137par" "" "")) (concat (with "font-series" "bold" "注意事项") "：") "1、构建采用非社区版（is_community=n)" (concat "2、提交的pr的标题、正文，参考09开头编号的pr，比如：" (hlink "[1601] 修复释义引文1（上下文）的半截 herk 与段落内容丢失，上下文预算拉齐 by PinkMagicFly <centerdot> Pull Request #4627 <centerdot> MoganLab/mogan" "https://github.com/MoganLab/mogan/pull/4627")) "3、devel里惯例要写的任务文档，追加在本文件中。" "4、可以采用 Python 的 pynput 框架来自动化测试" "" "验收标准：" "      检验文字：" (with "par-first" "2fn" (document (concat "表应具有自明性。为使表格简洁易读，尽可能采用三线表，如表" (nbsp) (reference "table:1-1") (nbsp) "所示是`小表格`。三条线可以先选中第一行，在工具栏倒数第五个按钮设置双线的边界，然后同理选中最后一行，设置单线边界。"))) "" (padded-center (document (small-table (concat (tabular (tformat (cwith "1" "1" "1" "-1" "cell-bborder" "1ln") (cwith "2" "2" "1" "-1" "cell-tborder" "1ln") (cwith "6" "6" "1" "-1" "cell-tborder" "0ln") (cwith "5" "5" "1" "-1" "cell-bborder" "0ln") (cwith "1" "1" "1" "-1" "cell-height" "2em") (cwith "1" "1" "1" "-1" "cell-vmode" "exact") (cwith "2" "-1" "1" "-1" "cell-height" "2em") (cwith "2" "-1" "1" "-1" "cell-vmode" "exact") (cwith "1" "-1" "1" "-1" "cell-valign" "c") (cwith "1" "1" "1" "-1" "cell-tborder" "2ln") (cwith "6" "6" "1" "-1" "cell-bborder" "2ln") (cwith "1" "-1" "1" "1" "cell-lborder" "0ln") (cwith "1" "-1" "2" "2" "cell-rborder" "0ln") (table (row (cell "文件名") (cell "描述")) (row (cell "thuthesis.dtx") (cell "模板的源文件，包括文档和注释")) (row (cell "thuthesis.cls") (cell "模板文件")) (row (cell "thuthesis-*.bst") (cell "BibTeX 参考文献表样式文件")) (row (cell "thuthesis-*.bbx") (cell "BibLaTeX 参考文献表样式文件")) (row (cell "thuthesis-*.cbx") (cell "BibLaTeX 引用样式文件"))))) (label "table:1-1")) "三线表示例"))) (with "par-first" "2fn" (document (concat "表格如果需要注释，可以在文本后面点击 `插入<rightarrow>外观标记<rightarrow>上标`，然后在表格下方写注释，参考表" (nbsp) (reference "table:2-2") (nbsp) "。"))) (big-table (document (concat (tabular (tformat (cwith "1" "-1" "1" "1" "cell-width" "2cm") (cwith "1" "-1" "1" "1" "cell-hmode" "exact") (cwith "2" "-1" "1" "-1" "cell-hyphen" "c") (cwith "1" "-1" "1" "1" "cell-halign" "c") (cwith "1" "-1" "2" "2" "cell-width" "4cm") (cwith "1" "-1" "2" "2" "cell-hmode" "exact") (cwith "1" "-1" "2" "2" "cell-halign" "l") (cwith "1" "-1" "1" "-1" "cell-valign" "t") (cwith "1" "-1" "3" "3" "cell-halign" "r") (cwith "1" "-1" "3" "3" "cell-width" "6cm") (cwith "1" "-1" "3" "3" "cell-hmode" "exact") (cwith "2" "2" "3" "3" "cell-halign" "r") (cwith "1" "1" "1" "-1" "cell-tborder" "2ln") (cwith "1" "1" "1" "1" "cell-lborder" "0ln") (cwith "1" "1" "3" "3" "cell-rborder" "0ln") (cwith "2" "2" "1" "-1" "cell-tborder" "1ln") (cwith "1" "1" "1" "-1" "cell-bborder" "1ln") (cwith "2" "2" "1" "1" "cell-lborder" "0ln") (cwith "2" "2" "3" "3" "cell-rborder" "0ln") (cwith "3" "3" "1" "-1" "cell-tborder" "0ln") (cwith "2" "2" "1" "-1" "cell-bborder" "0ln") (cwith "3" "3" "1" "-1" "cell-bborder" "2ln") (cwith "3" "3" "1" "1" "cell-lborder" "0ln") (cwith "3" "3" "3" "3" "cell-rborder" "0ln") (cwith "1" "-1" "1" "-1" "cell-height" "") (cwith "1" "-1" "1" "-1" "cell-vmode" "auto") (cwith "1" "1" "1" "-1" "cell-height" "2em") (cwith "1" "1" "1" "-1" "cell-vmode" "exact") (cwith "1" "1" "1" "-1" "cell-valign" "c") (cwith "2" "-1" "1" "-1" "cell-valign" "t") (cwith "2" "-1" "1" "-1" "cell-bsep" "0.5fn") (cwith "2" "-1" "1" "-1" "cell-tsep" "0.5fn") (table (row (cell "2cm") (cell "4cm") (cell "6cm")) (row (cell (document (concat "左右居中2cm宽度" (hover-balloon "" "" "left" "Bottom") (rsup "a")))) (cell (document "左右居左4cm宽度")) (cell (document "左右居右6cm宽度"))) (row (cell (document (concat "左右居中2cm宽度" (hover-balloon "" "" "left" "Bottom") (rsup "b")))) (cell (document "左右居左4cm宽度左右居左4cm宽度")) (cell (document "左右居右6cm宽度左右居右 6cm宽度")))))) (label "table:2-2")) "" (concat (hover-balloon "" ""