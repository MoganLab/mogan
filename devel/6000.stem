(document (TeXmacs "2.1.4")
  (style (tuple "generic" "chinese" "table-captions-above" "number-europe"
           "preview-ref" "bash"
         ) ;tuple
  ) ;style
  (body
    (document (chapter* "[6000] 有背景色的PDF导出右边会有细线")
      (section* "1 相关文档")
      (itemize (document (concat (item) (hlink "dddd.md" "dddd.md") " - 任务文档模板"))
      ) ;itemize
      (section* "2 任务相关的代码文件")
      (itemize (document (concat (item)
                           "src/Plugins/Pdf/pdf_hummus_renderer.cpp - PDF 渲染器整页裁剪与背景绘制"
                         ) ;concat
                 (concat (item) "TeXmacs/tests/6000.scm - 集成测试")
                 (concat (item) "TeXmacs/tests/python/6000.py - 端到端测试脚本")
                 (concat (item) "TeXmacs/tests/tmu/6000.tmu - 测试用深色文档")
               ) ;document
      ) ;itemize
      (section* "3 如何测试")
      (subsection* "3.1 单元测试")
      "此任务主要依赖集成测试与端到端测试验证。"
      (subsection* "3.2 集成测试")
      "运行 Scheme 集成测试："
      (bash-code (document "xmake r 6000"))
      (subsection* "3.3 端到端测试")
      "端到端测试既可以手动测试，也可以采用 Python 自动化测试："
      (itemize
        (document (concat (item) (with "font-series" "bold" "自动化测试") "：")
          (bash-code (document "python3 TeXmacs/tests/python/6000.py"))
          (concat (item) (with "font-series" "bold" "手动测试") "：")
          (enumerate (document (concat (item)
                                 "先手动将文档（可以直接使用本文档）设置为黑夜模式"
                               ) ;concat
                       (concat (item) "点击 文件→导出为PDF")
                       (concat (item)
                         "选中【导出PDF的时候，仍旧采用深色模式】选项"
                       ) ;concat
                       (concat (item) "点击导出")
                       (concat (item)
                         "采用PDF阅读器打开，在全屏的情况下，右侧会有白色细线。修复后，在全屏的情况下，右侧没有白色细线"
                       ) ;concat
                     ) ;document
          ) ;enumerate
        ) ;document
      ) ;itemize
      (section* "5 What")
      "修复了有背景色的文档导出为PDF后，在PDF阅读器中全屏查看时右侧（以及边缘）出现白色细线的问题。"
      (section* "6 Why")
      "产生右侧细线的原因主要有两个："
      (enumerate (document (concat (item)
                             "pdf_hummus_renderer_rep::begin_page () 中额外调用了 set_clipping 向 PDF 内容流输出了全页裁剪路径（re W n）。PDF 规范中页面物理边界已由 MediaBox 规定，输出内容流裁剪路径会导致阅读器栅格化时视口边缘像素中心落在裁剪区域外被剔除。"
                           ) ;concat
                   (concat (item)
                     "pdf_hummus_renderer_rep::clear 在绘制背景时，坐标在点与像素之间转换发生整数截断，绘制的矩形边界恰好小于或仅等于纸张标称点数，在各种非 72 倍数的屏幕缩放/DPI 栅格化时，最外层一列像素未被着色，显露底层白色画布。"
                   ) ;concat
                 ) ;document
      ) ;enumerate
      (section* "7 How")
      "解决方案："
      (enumerate (document (concat (item)
                             "在 pdf_hummus_renderer_rep::begin_page () 中，仅调用 renderer_rep::set_clipping 维护内部可视逻辑边界，不向 PDF 输出整页硬裁剪路径，交由 PDF MediaBox 自行定义页面裁切。"
                           ) ;concat
                   (concat (item)
                     "在 pdf_hummus_renderer_rep::clear 中，当检测到绘制区域为整页背景时，将绘制矩形边界向外对称扩展若干点（margin = max (10, (SI) (5.0 * dpi / default_dpi))），保证任何分辨率与全屏栅格化下，背景色均能完整覆盖至页面物理边界像素。"
                   ) ;concat
                   (concat (item)
                     "添加集成测试 TeXmacs/tests/6000.scm 与自动化脚本 TeXmacs/tests/python/6000.py，导出深色 PDF 并在多 DPI 下验证各边缘均无白色细线。"
                   ) ;concat
                 ) ;document
      ) ;enumerate
    ) ;document
  ) ;body
  (initial (collection (associate "page-screen-margin" "false")
             (associate "save-aux" "false")
             (associate "stem-doc-id" "2874AE38-0691-4E10-8043-BBE3CE6E3A90")
           ) ;collection
  ) ;initial
) ;document
