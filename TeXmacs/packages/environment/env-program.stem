(document (TeXmacs "2.1.2")
  (style (tuple "source" "std"))
  (body (document (active* (src-title (document (src-package "env-program" "1.0")
                                        (src-purpose (document "Some environments for typesetting algorithms."))
                                        (src-copyright "1998--2020"
                                          "Joris van der Hoeven, Franï£¡ois Poulain, Darcy Shen"
                                        ) ;src-copyright
                                        (src-license (document (concat "This software falls under the "
                                                                 (hlink "GNU general public license, version 3 or later" "$TEXMACS_PATH/LICENSE")
                                                                 ". It comes WITHOUT ANY WARRANTY WHATSOEVER. You should have received a copy of the license which the software. If not, see "
                                                                 (hlink "http://www.gnu.org/licenses/gpl-3.0.html"
                                                                   "http://www.gnu.org/licenses/gpl-3.0.html"
                                                                 ) ;hlink
                                                                 "."
                                                               ) ;concat
                                                     ) ;document
                                        ) ;src-license
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (use-package "environment/env-pseudo-code")
          (active* (document (src-comment (document "Code environments"))))
          (assign "code-numbered-offset" "0.5tab")
          (assign "render-code"
            (macro "body"
              (document (surround ""
                          (no-indent*)
                          (document (padded* (document (indent (document (with "par-first"
                                                                           "0fn"
                                                                           "par-par-sep"
                                                                           "0fn"
                                                                           "item-hsep"
                                                                           (macro "1tab")
                                                                           "numbered-offset"
                                                                           (value "code-numbered-offset")
                                                                           (document (arg "body"))
                                                                         ) ;with
                                                               ) ;document
                                                       ) ;indent
                                             ) ;document
                                    ) ;padded*
                          ) ;document
                        ) ;surround
              ) ;document
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Algorithmic environments"))))
          (assign "algorithm-name" (macro "name" (enunciation-name (arg "name"))))
          (assign "algorithm-sep" (macro (enunciation-sep)))
          (assign "algorithm-numbered-offset" "0.5tab")
          (assign "render-algorithm"
            (macro "name"
              "body"
              (document (padded* (document (with "par-first"
                                             "0fn"
                                             "par-par-sep"
                                             "0fn"
                                             "item-hsep"
                                             (macro "1tab")
                                             "numbered-offset"
                                             (value "algorithm-numbered-offset")
                                             (document (surround "" (vspace "0.5fn") (algorithm-name (arg "name")))
                                               (surround ""
                                                 (yes-indent*)
                                                 (document (algorithm-indent (document (arg "body"))))
                                               ) ;surround
                                             ) ;document
                                           ) ;with
                                 ) ;document
                        ) ;padded*
              ) ;document
            ) ;macro
          ) ;assign
          (assign "render-specified-algorithm"
            (macro "name"
              "intro"
              "body"
              (document (padded* (document (with "par-first"
                                             "0fn"
                                             "par-par-sep"
                                             "0fn"
                                             "item-hsep"
                                             (macro "1tab")
                                             "numbered-offset"
                                             (value "algorithm-numbered-offset")
                                             (document (surround ""
                                                         (vspace "0.5fn")
                                                         (document (algorithm-name (arg "name")) (arg "intro"))
                                                       ) ;surround
                                               (surround ""
                                                 (yes-indent*)
                                                 (document (algorithm-indent (document (arg "body"))))
                                               ) ;surround
                                             ) ;document
                                           ) ;with
                                 ) ;document
                        ) ;padded*
              ) ;document
            ) ;macro
          ) ;assign
          (new-algorithm "algorithm" "Algorithm")
          (active* (document (src-comment (document "Floating algorithmic environments")))
          ) ;active*
          (new-figure "algorithm" "Algorithm")
          (assign "render-small-algorithm"
            (macro "type"
              "name"
              "fig"
              "cap"
              (tabular* (tformat (cwith "1" "-1" "1" "-1" "cell-lsep" "0spc")
                          (cwith "1" "-1" "1" "-1" "cell-rsep" "0spc")
                          (cwith "2" "2" "1" "1" "cell-height" "0.5fn")
                          (twith "table-valign" "B")
                          (cwith "3" "3" "1" "1" "cell-hyphen" "t")
                          (twith "table-width" "1par")
                          (twith "table-hmode" "min")
                          (table (row (cell (resize (arg "fig") (minus "1l" "2fn") "" (plus "1r" "2fn") "")))
                            (row (cell ""))
                            (row (cell (document (small (surround (concat (figure-name (concat (arg "name") (figure-sep)))
                                                                    (list-caption (arg "type") (arg "cap"))
                                                                  ) ;concat
                                                          ""
                                                          (document (arg "cap"))
                                                        ) ;surround
                                                 ) ;small
                                       ) ;document
                                 ) ;cell
                            ) ;row
                          ) ;table
                        ) ;tformat
              ) ;tabular*
            ) ;macro
          ) ;assign
          (assign "render-big-algorithm"
            (macro "type"
              "name"
              "fig"
              "cap"
              (document (padded-normal (enunciation-padding)
                          (enunciation-padding)
                          (tabular* (tformat (twith "table-width" "1par")
                                      (cwith "3" "3" "1" "1" "cell-hyphen" "t")
                                      (cwith "1" "-1" "1" "-1" "cell-lsep" "0spc")
                                      (cwith "1" "-1" "1" "-1" "cell-rsep" "0spc")
                                      (cwith "2" "2" "1" "1" "cell-height" "0.5fn")
                                      (cwith "3" "3" "1" "1" "cell-lsep" "1.5fn")
                                      (cwith "3" "3" "1" "1" "cell-rsep" "1.5fn")
                                      (table (row (cell (arg "fig")))
                                        (row (cell ""))
                                        (row (cell (document (small (surround (concat (figure-name (concat (arg "name") (figure-sep)))
                                                                                (list-caption (arg "type") (arg "cap"))
                                                                              ) ;concat
                                                                      ""
                                                                      (document (arg "cap"))
                                                                    ) ;surround
                                                             ) ;small
                                                   ) ;document
                                             ) ;cell
                                        ) ;row
                                      ) ;table
                                    ) ;tformat
                          ) ;tabular*
                        ) ;padded-normal
              ) ;document
            ) ;macro
          ) ;assign
          ""
          (assign "algorithm-name" (macro "name" (strong (arg "name"))))
          (active* (document (src-comment (document "Special layout markup for algorithms")))
          ) ;active*
          (assign "algorithm-indentation" "1tab")
          (assign "indent-indentation" "1tab")
          (assign "algorithm-indent"
            (macro "body"
              (document (surround ""
                          (right-flush)
                          (document (with "par-left"
                                      (plus (value "par-left") (value "algorithm-indentation"))
                                      (document (arg "body"))
                                    ) ;with
                          ) ;document
                        ) ;surround
              ) ;document
            ) ;macro
          ) ;assign
          (assign "indent*"
            (macro "body"
              (document (with "par-left"
                          (plus (value "par-left") (value "indent-indentation"))
                          (document (arg "body"))
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (assign "indent"
            (macro "body"
              (document (surround "" (right-flush) (document (indent* (document (arg "body")))))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "tabbed"
            (macro "body"
              (tformat (twith "table-valign" "T")
                (twith "table-width" "1par")
                (twith "table-hmode" "min")
                (cwith "1" "-1" "1" "-1" "cell-halign" "l")
                (cwith "1" "-1" "1" "-1" "cell-lsep" "0spc")
                (cwith "1" "-1" "1" "-1" "cell-rsep" "0spc")
                (cwith "1"
                  "-2"
                  "1"
                  "-1"
                  "cell-bsep"
                  (plus (value "par-sep") (value "par-line-sep"))
                ) ;cwith
                (cwith "1" "-1" "-1" "-1" "cell-hpart" "1")
                (cwith "1" "-1" "-1" "-1" "cell-hyphen" "t")
                (arg "body")
              ) ;tformat
            ) ;macro
          ) ;assign
          (assign "tabbed*"
            (macro "body"
              (tformat (twith "table-valign" "T")
                (twith "table-width" "1par")
                (twith "table-hmode" "min")
                (cwith "1" "-1" "1" "-1" "cell-halign" "l")
                (cwith "1" "-1" "1" "-1" "cell-lsep" "0spc")
                (cwith "1" "-1" "1" "-1" "cell-rsep" "0spc")
                (cwith "1" "-1" "1" "-1" "cell-bsep" "0spc")
                (cwith "1" "-1" "1" "-1" "cell-tsep" "0spc")
                (cwith "1" "-1" "-1" "-1" "cell-hpart" "1")
                (cwith "1" "-1" "-1" "-1" "cell-hyphen" "t")
                (cwith "1" "-1" "-1" "-1" "cell-vcorrect" "n")
                (arg "body")
              ) ;tformat
            ) ;macro
          ) ;assign
          (assign "wide-tabbed"
            (macro "body"
              (tformat (twith "table-valign" "T")
                (twith "table-width" "1par")
                (twith "table-hmode" "exact")
                (cwith "1" "-1" "1" "-1" "cell-halign" "l")
                (cwith "1" "-1" "1" "-1" "cell-lsep" "0spc")
                (cwith "1" "-1" "1" "-1" "cell-rsep" "0spc")
                (cwith "1"
                  "-2"
                  "1"
                  "-1"
                  "cell-bsep"
                  (plus (value "par-sep") (value "par-line-sep"))
                ) ;cwith
                (cwith "1" "-1" "-1" "-1" "cell-hpart" "1")
                (cwith "1" "-1" "-1" "-1" "cell-hyphen" "t")
                (arg "body")
              ) ;tformat
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Standard languages"))))
          (assign "scheme" (macro (name "Scheme")))
          (assign "c++" (macro (name "C++")))
          (assign "shell"
            (macro "body"
              (with "mode" "prog" "prog-language" "shell" "font-family" "rm" (arg "body"))
            ) ;macro
          ) ;assign
          (assign "scm"
            (macro "body"
              (with "mode" "prog" "prog-language" "scheme" "font-family" "rm" (arg "body"))
            ) ;macro
          ) ;assign
          (assign "cpp"
            (macro "body"
              (with "mode" "prog" "prog-language" "cpp" "font-family" "rm" (arg "body"))
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Blocks of code for standard languages")))
          ) ;active*
          (assign "pseudo-code"
            (macro "body" (document (render-code (document (arg "body")))))
          ) ;assign
          (assign "verbatim-code"
            (macro "body" (document (pseudo-code (document (verbatim (arg "body"))))))
          ) ;assign
          (assign "scm-code"
            (macro "body" (document (pseudo-code (document (scm (arg "body"))))))
          ) ;assign
          (assign "shell-code"
            (macro "body" (document (pseudo-code (document (shell (arg "body"))))))
          ) ;assign
          (assign "cpp-code"
            (macro "body" (document (pseudo-code (document (cpp (arg "body"))))))
          ) ;assign
          (active* (document (src-comment (document "Deprecated markup for algorithms"))))
          (assign "named-algorithm-old"
            (macro "name"
              "body"
              (surround (vspace* "1fn")
                (concat (vspace "1fn") (right-flush) (yes-indent*))
                (with "par-first"
                  "0cm"
                  (surround (concat (strong (translate "Algorithm" "english" (language)))
                              " "
                              (tt (arg "name"))
                            ) ;concat
                    ""
                    (with "item*" (macro "what" (strong (concat (arg "what") " "))) (arg "body"))
                  ) ;surround
                ) ;with
              ) ;surround
            ) ;macro
          ) ;assign
          (assign "algorithm-body"
            (macro "body"
              (surround (vspace* "0.5fn")
                (yes-indent*)
                (with "item*"
                  (macro "name" (concat (vspace* "0.5fn") (strong (concat (arg "name") " "))))
                  (arg "body")
                ) ;with
              ) ;surround
            ) ;macro
          ) ;assign
          (assign "minimal"
            (macro "body" (with "mode" "prog" "prog-language" "minimal" (arg "body")))
          ) ;assign
          (active* (document (src-comment (document "Line numbered listings"))))
          (assign "numbered-offset" "-1spc")
          (assign "numbered-color" "dark grey")
          (assign "numbered-font-size" "0.841")
          (assign "numbered-block"
            (macro "body"
              (document (surround ""
                          (right-flush)
                          (document (with "line-nr" "0" (document (arg "body"))))
                        ) ;surround
              ) ;document
            ) ;macro
          ) ;assign
          (assign "render-line-number"
            (macro "nr"
              "offset"
              (concat (set-binding (arg "nr"))
                (line-note (with "color"
                             (value "numbered-color")
                             "font-size"
                             (value "numbered-font-size")
                             "font-shape"
                             "upright"
                             "font-series"
                             "medium"
                             (move (arg "nr") "-1r" "")
                           ) ;with
                  (arg "offset")
                  "0cm"
                ) ;line-note
              ) ;concat
            ) ;macro
          ) ;assign
          (assign "numbered-line"
            (macro "body"
              (concat (assign "line-nr" (plus (value "line-nr") "1"))
                (render-line-number (value "line-nr") (value "numbered-offset"))
                (arg "body")
              ) ;concat
            ) ;macro
          ) ;assign
          (assign "listing-sep" "0.2fn")
          (assign "numbered"
            (macro "body"
              (document (with "dummy1"
                          (value "numbered-offset")
                          "dummy2"
                          (value "numbered-color")
                          "dummy3"
                          (value "numbered-font-size")
                          "par-sep"
                          (value "listing-sep")
                          "par-par-sep"
                          "0fn"
                          (document (extern "ext-numbered" (quote-arg "body")))
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (drd-props "numbered" "arity" "1" "accessible" "all")
          (assign "listing"
            (macro "body"
              (document (with "dummy1"
                          (value "numbered-offset")
                          "dummy2"
                          (value "numbered-color")
                          "dummy3"
                          (value "numbered-font-size")
                          "par-sep"
                          (value "listing-sep")
                          "par-par-sep"
                          "0fn"
                          (document (extern "ext-numbered-prog" (quote-arg "body") "verbatim"))
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (drd-props "listing" "arity" "1" "accessible" "all")
          (assign "shell-listing"
            (macro "body"
              (document (with "dummy1"
                          (value "numbered-offset")
                          "dummy2"
                          (value "numbered-color")
                          "dummy3"
                          (value "numbered-font-size")
                          "par-sep"
                          (value "listing-sep")
                          "par-par-sep"
                          "0fn"
                          (document (extern "ext-numbered-prog" (quote-arg "body") "shell"))
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (drd-props "shell-listing" "arity" "1" "accessible" "all")
          (assign "scm-listing"
            (macro "body"
              (document (with "dummy1"
                          (value "numbered-offset")
                          "dummy2"
                          (value "numbered-color")
                          "dummy3"
                          (value "numbered-font-size")
                          "par-sep"
                          (value "listing-sep")
                          "par-par-sep"
                          "0fn"
                          (document (extern "ext-numbered-prog" (quote-arg "body") "scheme"))
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (drd-props "scm-listing" "arity" "1" "accessible" "all")
          (assign "cpp-listing"
            (macro "body"
              (document (with "dummy1"
                          (value "numbered-offset")
                          "dummy2"
                          (value "numbered-color")
                          "dummy3"
                          (value "numbered-font-size")
                          "par-sep"
                          (value "listing-sep")
                          "par-par-sep"
                          "0fn"
                          (document (extern "ext-numbered-prog" (quote-arg "body") "cpp"))
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (drd-props "cpp-listing" "arity" "1" "accessible" "all")
          (active* (document (src-comment (document "Fancy listings using stripes"))))
          (assign "striped-table"
            (macro "body"
              (tformat (cwith "1"
                         "-1"
                         "1"
                         "-1"
                         "cell-background"
                         (if (equal (mod (value "cell-row-nr") "2") "0") "#f4f4ff" "")
                       ) ;cwith
                (twith "table-width" "1par")
                (twith "table-hmode" "exact")
                (arg "body")
              ) ;tformat
            ) ;macro
          ) ;assign
          (initial (collection (associate "preamble" "true") (associate "sfactor" "5")))
        ) ;document
  ) ;body
) ;document
