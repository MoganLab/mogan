(document (TeXmacs "1.0.7.20")
  (style "source")
  (body (document (active* (src-title (document (src-package "env-flush-math" "1.0")
                                        (src-purpose (document "Mathematical environments (equations and equation arrays) flushed to the left."
                                                     ) ;document
                                        ) ;src-purpose
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (use-package "env-math")
          (active* (document (src-comment (document "Styling parameters."))))
          (assign "eqn-left-indent" (macro "1.5fn"))
          (active* (document (src-comment (document "Single equations."))))
          (assign "equation*"
            (macro "body"
              (with "mode"
                "math"
                "math-display"
                "true"
                "par-ver-sep"
                (eqn-ver-sep)
                (document (indent-left (eqn-left-indent)
                            (style-with "src-compact"
                              "none"
                              (surround (concat (no-page-break*) (vspace* (eqn-short-above)) (no-indent))
                                (concat (htab "0fn") (vspace (eqn-short-below)) (no-indent*))
                                (arg "body")
                              ) ;surround
                            ) ;style-with
                          ) ;indent-left
                ) ;document
              ) ;with
            ) ;macro
          ) ;assign
          (assign "equation-lab"
            (macro "body"
              "lab"
              (document (surround (set-binding (arg "lab"))
                          (concat (htab "5mm") (with "mode" "text" (concat "(" (arg "lab") ")")))
                          (document (equation* (document (arg "body"))))
                        ) ;surround
              ) ;document
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Equation arrays."))))
          (assign "equations-base"
            (macro "body"
              (document (with "mode"
                          "math"
                          "math-display"
                          "true"
                          "par-mode"
                          "left"
                          "par-sep"
                          (eqn-row-sep)
                          (document (indent-left (eqn-left-indent)
                                      (document (style-with "src-compact"
                                                  "none"
                                                  (surround (concat (no-page-break*) (vspace* (eqn-long-above)) (no-indent))
                                                    (concat (vspace (eqn-long-below)) (no-indent*))
                                                    (document (arg "body"))
                                                  ) ;surround
                                                ) ;style-with
                                      ) ;document
                                    ) ;indent-left
                          ) ;document
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (assign "old-eqnarray*" (value "eqnarray*"))
          (assign "eqnarray*"
            (macro "body"
              (document (old-eqnarray* (tformat (cwith "1" "-1" "1" "1" "cell-hpart" "0")
                                         (cwith "1" "-1" "1" "1" "cell-hyphen" "n")
                                         (arg "body")
                                       ) ;tformat
                        ) ;old-eqnarray*
              ) ;document
            ) ;macro
          ) ;assign
          (assign "old-align*" (value "align*"))
          (assign "align*"
            (macro "body"
              (document (old-align* (tformat (cwith "1" "-1" "1" "1" "cell-hpart" "0")
                                      (cwith "1" "-1" "1" "1" "cell-hyphen" "n")
                                      (arg "body")
                                    ) ;tformat
                        ) ;old-align*
              ) ;document
            ) ;macro
          ) ;assign
          (assign "old-gather*" (value "gather*"))
          (assign "gather*"
            (macro "body"
              (document (old-gather* (tformat (cwith "1" "-1" "1" "-1" "cell-halign" "l") (arg "body")))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "old-multline*" (value "multline*"))
          (assign "multline*"
            (macro "body"
              (document (old-multline* (tformat (cwith "1" "-1" "1" "-1" "cell-halign" "l") (arg "body"))
                        ) ;old-multline*
              ) ;document
            ) ;macro
          ) ;assign
          ""
        ) ;document
  ) ;body
  (initial (collection (associate "preamble" "true")))
) ;document
