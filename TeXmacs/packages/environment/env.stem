(document (TeXmacs "1.0.7.9")
  (style "source")
  (body (document (active* (src-title (document (src-package "env" "1.0")
                                        (src-purpose (document (concat "Common " (TeXmacs) " environments.")))
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (use-package "environment/env-base" "environment/env-math"
            "environment/env-theorem" "environment/env-float"
            "environment/env-program"
          ) ;use-package
          ""
        ) ;document
  ) ;body
  (initial (collection (associate "preamble" "true")))
) ;document
