(document (TeXmacs "1.99.20")
  (style "source")
  (body (document (active* (src-title (document (src-package "env-math" "1.0")
                                        (src-purpose (document "Mathematical environments (equations and equation arrays).")
                                        ) ;src-purpose
                                        (src-copyright "1998--2004" "Joris van der Hoeven")
                                        (src-license (document (concat "This software falls under the "
                                                                 (hlink "GNU general public license, version 3 or later" "$TEXMACS_PATH/LICENSE")
                                                                 ". It comes WITHOUT ANY WARRANTY WHATSOEVER. You should have received a copy of the license which the software. If not, see "
                                                                 (hlink "http://www.gnu.org/licenses/gpl-3.0.html"
                                                                   "http://www.gnu.org/licenses/gpl-3.0.html"
                                                                 ) ;hlink
                                                                 "."
                                                               ) ;concat
                                                     ) ;document
                                        ) ;src-license
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (active* (document (src-comment (document "Styling parameters."
                                            "  eqn-short-above + par-sep: smallest skip above equation (no collisions)."
                                            "  eqn-short-above + eqn-ver-sep: largest skip above equation (when collisions)."
                                            "  eqn-long-above + par-row-sep: skip above equation array."
                                            "  eqn-short-below and eqn-long-below: similar to above."
                                          ) ;document
                             ) ;src-comment
                   ) ;document
          ) ;active*
          (assign "eqn-short-above" (macro "0.35fn"))
          (assign "eqn-short-below" (macro "0.35fn"))
          (assign "eqn-long-above" (macro "0.5fn"))
          (assign "eqn-long-below" (macro "0.5fn"))
          (assign "eqn-ver-sep" (macro "0.6fn"))
          (assign "eqn-row-sep" (macro "0.45fn"))
          (active* (document (src-comment (document "Numbering equations."))))
          (assign "next-number"
            (macro (style-with "src-compact"
                     "none"
                     (concat (next-equation)
                       (with "mode" "text" "font-shape" "right" (concat "(" (the-equation) ")"))
                     ) ;concat
                   ) ;style-with
            ) ;macro
          ) ;assign
          (drd-props "next-number" "syntax" (macro ""))
          (assign "leq-number" (macro (concat (next-number) (htab "5mm"))))
          (assign "req-number" (macro (concat (htab "5mm") (next-number))))
          (assign "eq-number" (value "req-number"))
          (assign "eq-lab"
            (macro "lab"
              (concat (htab "5mm")
                (with "mode" "text" "font-shape" "right" (concat "(" (arg "lab") ")"))
              ) ;concat
            ) ;macro
          ) ;assign
          (assign "no-number" (macro ""))
          (assign "eqref" (macro "id" (concat "(" (reference (arg "id")) ")")))
          (active* (document (src-comment (document "Single equations."))))
          (assign "equation*"
            (macro "body"
              (with "mode"
                "math"
                "math-display"
                "true"
                "par-ver-sep"
                (eqn-ver-sep)
                (document (style-with "src-compact"
                            "none"
                            (surround (concat (no-page-break*) (vspace* (eqn-short-above)) (no-indent) (htab "0fn"))
                              (concat (htab "0fn") (vspace (eqn-short-below)) (no-indent*))
                              (arg "body")
                            ) ;surround
                          ) ;style-with
                ) ;document
              ) ;with
            ) ;macro
          ) ;assign
          (assign "equation-lab"
            (macro "body"
              "lab"
              (document (surround (set-binding (arg "lab"))
                          (concat (space "5mm")
                            (with "mode" "text" "font-shape" "right" (concat "(" (arg "lab") ")"))
                          ) ;concat
                          (document (equation* (document (arg "body"))))
                        ) ;surround
              ) ;document
            ) ;macro
          ) ;assign
          (assign "equation"
            (macro "body"
              (document (surround (next-equation)
                          ""
                          (document (equation-lab (document (arg "body")) (the-equation)))
                        ) ;surround
              ) ;document
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Equation arrays."))))
          (assign "equations-base"
            (macro "body"
              (document (with "mode"
                          "math"
                          "math-display"
                          "true"
                          "par-mode"
                          "center"
                          "par-sep"
                          (eqn-row-sep)
                          "par-first"
                          "0em"
                          "par-swell"
                          (value "math-swell")
                          (document (style-with "src-compact"
                                      "none"
                                      (surround (concat (no-page-break*) (vspace* (eqn-long-above)))
                                        (concat (vspace (eqn-long-below)) (no-indent*))
                                        (arg "body")
                                      ) ;surround
                                    ) ;style-with
                          ) ;document
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (assign "eqnarray*"
            (macro "body"
              (document (equations-base (document (tformat (twith "table-hyphen" "y")
                                                    (twith "table-width" "1par")
                                                    (twith "table-min-cols" "3")
                                                    (twith "table-max-cols" "3")
                                                    (cwith "1" "-1" "1" "1" "cell-lsep" "0spc")
                                                    (cwith "1" "-1" "-1" "-1" "cell-rsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-bsep" "0.1fn")
                                                    (cwith "1" "-1" "1" "-1" "cell-tsep" "0.1fn")
                                                    (cwith "1" "-1" "1" "1" "cell-hpart" "1")
                                                    (cwith "1" "-1" "-1" "-1" "cell-hpart" "1")
                                                    (cwith "1" "-1" "1" "1" "cell-halign" "r")
                                                    (cwith "1" "-1" "1" "1" "cell-hyphen" "b")
                                                    (cwith "1" "-1" "2" "-2" "cell-halign" "c")
                                                    (cwith "1" "-1" "-1" "-1" "cell-halign" "l")
                                                    (cwith "1" "-1" "-1" "-1" "cell-hyphen" "t")
                                                    (cwith "1" "-1" "1" "-1" "cell-block" "no")
                                                    (arg "body")
                                                  ) ;tformat
                                        ) ;document
                        ) ;equations-base
              ) ;document
            ) ;macro
          ) ;assign
          (assign "rcl-table"
            (macro "body"
              (tformat (cwith "1" "-1" "1" "-1" "cell-bsep" "0sep")
                (cwith "1" "-1" "1" "-1" "cell-tsep" "0sep")
                (cwith "1" "-2" "1" "-1" "cell-bsep" (over (eqn-row-sep) "2"))
                (cwith "2" "-1" "1" "-1" "cell-tsep" (over (eqn-row-sep) "2"))
                (cwith "1" "-1" "1" "1" "cell-hpart" "1")
                (cwith "1" "-1" "-1" "-1" "cell-hpart" "1")
                (cwith "1" "-1" "1" "1" "cell-halign" "r")
                (cwith "1" "-1" "1" "1" "cell-hyphen" "b")
                (cwith "1" "-1" "2" "-2" "cell-halign" "c")
                (cwith "1" "-1" "-1" "-1" "cell-halign" "l")
                (cwith "1" "-1" "-1" "-1" "cell-hyphen" "t")
                (cwith "1" "-1" "1" "-1" "cell-block" "no")
                (arg "body")
              ) ;tformat
            ) ;macro
          ) ;assign
          (assign "eqnarray" (macro "body" (document (eqnarray* (tformat (arg "body"))))))
          (assign "leqnarray*"
            (macro "body"
              (document (equations-base (document (tformat (twith "table-hyphen" "y")
                                                    (twith "table-width" "1par")
                                                    (twith "table-min-cols" "3")
                                                    (twith "table-max-cols" "3")
                                                    (cwith "1" "-1" "1" "1" "cell-lsep" "0spc")
                                                    (cwith "1" "-1" "-1" "-1" "cell-rsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-bsep" "0sep")
                                                    (cwith "1" "-1" "1" "-1" "cell-tsep" "0sep")
                                                    (cwith "1" "-1" "-1" "-1" "cell-hpart" "1")
                                                    (cwith "1" "-1" "1" "1" "cell-halign" "r")
                                                    (cwith "1" "-1" "2" "-2" "cell-halign" "c")
                                                    (cwith "1" "-1" "-1" "-1" "cell-halign" "l")
                                                    (cwith "1" "-1" "-1" "-1" "cell-hyphen" "t")
                                                    (cwith "1" "-1" "1" "-1" "cell-block" "no")
                                                    (arg "body")
                                                  ) ;tformat
                                        ) ;document
                        ) ;equations-base
              ) ;document
            ) ;macro
          ) ;assign
          (assign "leqnarray"
            (macro "body" (document (leqnarray* (tformat (arg "body")))))
          ) ;assign
          (assign "align*"
            (macro "body"
              (document (equations-base (document (tformat (twith "table-hyphen" "y")
                                                    (twith "table-width" "1par")
                                                    (twith "table-min-cols" "2")
                                                    (twith "table-max-cols" "2")
                                                    (cwith "1" "-1" "1" "1" "cell-lsep" "0spc")
                                                    (cwith "1" "-1" "1" "1" "cell-rsep" "0.5spc")
                                                    (cwith "1" "-1" "-1" "-1" "cell-rsep" "0spc")
                                                    (cwith "1" "-1" "-1" "-1" "cell-lsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-bsep" "0.1fn")
                                                    (cwith "1" "-1" "1" "-1" "cell-tsep" "0.1fn")
                                                    (cwith "1" "-1" "1" "1" "cell-hpart" "1")
                                                    (cwith "1" "-1" "-1" "-1" "cell-hpart" "1")
                                                    (cwith "1" "-1" "1" "1" "cell-halign" "r")
                                                    (cwith "1" "-1" "1" "1" "cell-hyphen" "b")
                                                    (cwith "1" "-1" "-1" "-1" "cell-halign" "l")
                                                    (cwith "1" "-1" "-1" "-1" "cell-hyphen" "t")
                                                    (cwith "1" "-1" "1" "-1" "cell-block" "no")
                                                    (arg "body")
                                                  ) ;tformat
                                        ) ;document
                        ) ;equations-base
              ) ;document
            ) ;macro
          ) ;assign
          (assign "align" (macro "body" (document (align* (tformat (arg "body"))))))
          (assign "alignat*"
            (macro "ncol" "body" (document (align* (tformat (arg "body")))))
          ) ;assign
          (assign "alignat"
            (macro "ncol" "body" (document (align (tformat (arg "body")))))
          ) ;assign
          (assign "aligned*"
            (macro "body"
              (document (math-table-base (tformat (twith "table-min-cols" "2")
                                           (twith "table-max-cols" "2")
                                           (cwith "1" "-1" "1" "1" "cell-lsep" "0spc")
                                           (cwith "1" "-1" "1" "1" "cell-rsep" "0.5spc")
                                           (cwith "1" "-1" "-1" "-1" "cell-rsep" "0spc")
                                           (cwith "1" "-1" "-1" "-1" "cell-lsep" "0spc")
                                           (cwith "1" "-1" "1" "-1" "cell-bsep" "0.1fn")
                                           (cwith "1" "-1" "1" "-1" "cell-tsep" "0.1fn")
                                           (cwith "1" "-1" "1" "1" "cell-halign" "r")
                                           (cwith "1" "-1" "-1" "-1" "cell-halign" "l")
                                           (cwith "1" "-1" "1" "-1" "cell-block" "no")
                                           (arg "body")
                                         ) ;tformat
                        ) ;math-table-base
              ) ;document
            ) ;macro
          ) ;assign
          (assign "aligned" (macro "body" (document (aligned* (tformat (arg "body"))))))
          (assign "alignedat*"
            (macro "ncol" "body" (document (aligned* (tformat (arg "body")))))
          ) ;assign
          (assign "alignedat"
            (macro "ncol" "body" (document (aligned* (tformat (arg "body")))))
          ) ;assign
          (assign "flalign*" (macro "body" (document (align* (tformat (arg "body"))))))
          (assign "flalign" (macro "body" (document (align (tformat (arg "body"))))))
          (assign "multline*"
            (macro "body"
              (document (equations-base (document (tformat (twith "table-hyphen" "y")
                                                    (twith "table-width" "1par")
                                                    (twith "table-min-cols" "1")
                                                    (twith "table-max-cols" "1")
                                                    (cwith "1" "-1" "1" "-1" "cell-lsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-rsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-bsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-tsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-hpart" "1")
                                                    (cwith "1" "-1" "1" "-1" "cell-hyphen" "b")
                                                    (cwith "1" "1" "1" "-1" "cell-halign" "l")
                                                    (cwith "2" "-1" "1" "-1" "cell-halign" "r")
                                                    (cwith "1" "-1" "1" "-1" "cell-block" "no")
                                                    (arg "body")
                                                  ) ;tformat
                                        ) ;document
                        ) ;equations-base
              ) ;document
            ) ;macro
          ) ;assign
          (assign "multline" (macro "body" (document (multline* (tformat (arg "body"))))))
          (assign "gather*"
            (macro "body"
              (document (equations-base (document (tformat (twith "table-hyphen" "y")
                                                    (twith "table-width" "1par")
                                                    (twith "table-min-cols" "1")
                                                    (twith "table-max-cols" "1")
                                                    (cwith "1" "-1" "1" "-1" "cell-lsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-rsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-bsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-tsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-hpart" "1")
                                                    (cwith "1" "-1" "1" "-1" "cell-hyphen" "b")
                                                    (cwith "1" "-1" "1" "-1" "cell-halign" "c")
                                                    (cwith "1" "-1" "1" "-1" "cell-block" "no")
                                                    (arg "body")
                                                  ) ;tformat
                                        ) ;document
                        ) ;equations-base
              ) ;document
            ) ;macro
          ) ;assign
          (assign "gather" (macro "body" (document (gather* (tformat (arg "body"))))))
          (assign "eqsplit*"
            (macro "body"
              (document (equations-base (document (tformat (twith "table-xhyphen" "y")
                                                    (twith "table-xwidth" "1par")
                                                    (twith "table-xhmode" "min")
                                                    (twith "table-min-cols" "1")
                                                    (twith "table-max-cols" "3")
                                                    (cwith "1" "-1" "1" "-1" "cell-lsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-rsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-bsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-tsep" "0spc")
                                                    (cwith "1" "-1" "1" "-1" "cell-hpart" "1")
                                                    (cwith "1" "-1" "1" "-1" "cell-hyphen" "b")
                                                    (cwith "1" "-1" "1" "1" "cell-halign" "r")
                                                    (cwith "1" "-1" "2" "-2" "cell-halign" "c")
                                                    (cwith "1" "-1" "-1" "-1" "cell-halign" "l")
                                                    (cwith "1" "-1" "1" "-1" "cell-block" "no")
                                                    (arg "body")
                                                  ) ;tformat
                                        ) ;document
                        ) ;equations-base
              ) ;document
            ) ;macro
          ) ;assign
          (assign "eqsplit" (macro "body" (document (eqsplit* (tformat (arg "body"))))))
          (assign "subequations" (macro "body" (document (arg "body"))))
          (active* (document (src-comment (document "Html export of equation arrays."))))
          (assign "big-math" (macro "x" (math (with "math-display" "true" (arg "x")))))
          (assign "rclx-base"
            (macro "body"
              (document (with "par-first"
                          "0em"
                          (document (style-with "src-compact"
                                      "none"
                                      (surround (concat (no-page-break*) (vspace* (eqn-long-above)))
                                        (concat (vspace (eqn-long-below)) (no-indent*))
                                        (arg "body")
                                      ) ;surround
                                    ) ;style-with
                          ) ;document
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (assign "cx-table"
            (macro "body"
              (document (rclx-base (document (tformat (twith "table-width" "1par")
                                               (twith "table-min-cols" "2")
                                               (twith "table-max-cols" "2")
                                               (cwith "1" "-1" "1" "1" "cell-lsep" "0spc")
                                               (cwith "1" "-1" "-1" "-1" "cell-rsep" "0spc")
                                               (cwith "1" "-1" "1" "-1" "cell-bsep" "0sep")
                                               (cwith "1" "-1" "1" "-1" "cell-tsep" "0sep")
                                               (cwith "1" "-1" "1" "1" "cell-hpart" "1")
                                               (cwith "1" "-1" "1" "1" "cell-halign" "c")
                                               (cwith "1" "-1" "-1" "-1" "cell-halign" "r")
                                               (cwith "1" "-1" "1" "-1" "cell-block" "no")
                                               (arg "body")
                                             ) ;tformat
                                   ) ;document
                        ) ;rclx-base
              ) ;document
            ) ;macro
          ) ;assign
          (assign "rclx-table"
            (macro "body"
              (document (rclx-base (document (tformat (twith "table-width" "1par")
                                               (twith "table-min-cols" "4")
                                               (twith "table-max-cols" "4")
                                               (cwith "1" "-1" "1" "1" "cell-lsep" "0spc")
                                               (cwith "1" "-1" "-1" "-1" "cell-rsep" "0spc")
                                               (cwith "1" "-1" "1" "-1" "cell-bsep" "0sep")
                                               (cwith "1" "-1" "1" "-1" "cell-tsep" "0sep")
                                               (cwith "1" "-2" "1" "-1" "cell-bsep" (eqn-row-sep))
                                               (cwith "1" "-1" "1" "1" "cell-hpart" "1")
                                               (cwith "1" "-1" "-2" "-2" "cell-hpart" "2")
                                               (cwith "1" "-1" "1" "1" "cell-halign" "r")
                                               (cwith "1" "-1" "1" "1" "cell-hyphen" "b")
                                               (cwith "1" "-1" "2" "-2" "cell-halign" "c")
                                               (cwith "1" "-1" "-2" "-2" "cell-halign" "l")
                                               (cwith "1" "-1" "-2" "-2" "cell-hyphen" "t")
                                               (cwith "1" "-1" "-1" "-1" "cell-halign" "r")
                                               (cwith "1" "-1" "1" "-1" "cell-block" "no")
                                               (arg "body")
                                             ) ;tformat
                                   ) ;document
                        ) ;rclx-base
              ) ;document
            ) ;macro
          ) ;assign
          (assign "tmhtml-eqnarray*"
            (macro "body" (extern "ext-tmhtml-eqnarray*" (arg "body")))
          ) ;assign
          ""
        ) ;document
  ) ;body
  (initial (collection (associate "preamble" "true") (associate "sfactor" "5")))
) ;document
