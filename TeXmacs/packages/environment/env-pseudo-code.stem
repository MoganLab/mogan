;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(document (TeXmacs "1.99.8")
  (style (tuple "source" "std"))
  (body (document (active* (src-title (document (src-package "env-pseudo-code" "1.0")
                                        (src-purpose (document "Some environments for typesetting pseudo-code."))
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (active* (document (src-comment (document "Rendering of keywords"))))
          (assign "render-keyword"
            (macro "name" (with "font-series" "bold" (localize (arg "name"))))
          ) ;assign
          (assign "render-keyword*"
            (macro "name" (with "font-series" "bold" (arg "name")))
          ) ;assign
          ""
          (assign "render-begin" (macro (render-keyword "begin")))
          (assign "render-call" (macro (render-keyword "call")))
          (assign "render-do" (macro (render-keyword "do")))
          (assign "render-else" (macro (render-keyword "else")))
          (assign "render-end" (macro (render-keyword "end")))
          (assign "render-false" (macro (render-keyword "false")))
          (assign "render-for-all" (macro (render-keyword "for all")))
          (assign "render-for-each" (macro (render-keyword "for each")))
          (assign "render-for" (macro (render-keyword "for")))
          (assign "render-function" (macro (render-keyword "function")))
          (assign "render-globals" (macro (render-keyword "globals")))
          (assign "render-if" (macro (render-keyword "if")))
          (assign "render-inputs" (macro (render-keyword "inputs")))
          (assign "render-loop" (macro (render-keyword "loop")))
          (assign "render-outputs" (macro (render-keyword "outputs")))
          (assign "render-print" (macro (render-keyword "print")))
          (assign "render-procedure" (macro (render-keyword "procedure")))
          (assign "render-repeat" (macro (render-keyword "repeat")))
          (assign "render-return" (macro (render-keyword "return")))
          (assign "render-then" (macro (render-keyword "then")))
          (assign "render-true" (macro (render-keyword "true")))
          (assign "render-until" (macro (render-keyword "until")))
          (assign "render-while" (macro (render-keyword "while")))
          (assign "render-and" (macro (render-keyword "and")))
          (assign "render-xor" (macro (render-keyword "xor")))
          (assign "render-or" (macro (render-keyword "or")))
          (assign "render-not" (macro (render-keyword "not")))
          (assign "render-to" (macro (render-keyword "to")))
          ""
          (assign "render-data" (macro (render-keyword "Data:")))
          (assign "render-ensure" (macro (render-keyword "Ensure:")))
          (assign "render-require" (macro (render-keyword "Require:")))
          (assign "render-result" (macro (render-keyword "Result:")))
          ""
          (assign "render-else-if" (macro (concat (render-else) " " (render-if))))
          (assign "render-end-for" (macro (concat (render-end) " " (render-for))))
          (assign "render-end-function"
            (macro (concat (render-end) " " (render-function)))
          ) ;assign
          (assign "render-end-if" (macro (concat (render-end) " " (render-if))))
          (assign "render-end-loop" (macro (concat (render-end) " " (render-loop))))
          (assign "render-end-procedure"
            (macro (concat (render-end) " " (render-procedure)))
          ) ;assign
          (assign "render-end-while" (macro (concat (render-end) " " (render-while))))
          (active* (document (src-comment (document "Constructs with block arguments"))))
          (assign "algo-procedure"
            (macro "name"
              "args"
              "body"
              (document (concat (render-procedure)
                          " "
                          (with "font-shape" "small-caps" (arg "name"))
                          "("
                          (arg "args")
                          ")"
                          (no-page-break)
                        ) ;concat
                (indent (document (arg "body")))
                (concat (render-end-procedure) (right-flush))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-function"
            (macro "name"
              "args"
              "body"
              (document (concat (render-function)
                          " "
                          (with "font-shape" "small-caps" (arg "name"))
                          "("
                          (arg "args")
                          ")"
                          (no-page-break)
                        ) ;concat
                (indent (document (arg "body")))
                (concat (render-end-function) (right-flush))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-for"
            (macro "cond"
              "block"
              (document (concat (render-for) " " (arg "cond") " " (render-do) (no-page-break))
                (indent (document (arg "block")))
                (concat (render-end-for) (right-flush))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-for-all"
            (macro "cond"
              "block"
              (document (concat (render-for-all) " " (arg "cond") " " (render-do) (no-page-break))
                (indent (document (arg "block")))
                (concat (render-end-for) (right-flush))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-for-each"
            (macro "cond"
              "block"
              (document (concat (render-for-each) " " (arg "cond") " " (render-do) (no-page-break))
                (indent (document (arg "block")))
                (concat (render-end-for) (right-flush))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-while"
            (macro "cond"
              "block"
              (document (concat (render-while) " " (arg "cond") " " (render-do) (no-page-break))
                (indent (document (arg "block")))
                (concat (render-end-while) (right-flush))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-repeat"
            (macro "cond"
              "block"
              (document (concat (render-repeat) (no-page-break))
                (indent (document (arg "block")))
                (surround (concat (render-until) " ") (right-flush) (arg "cond"))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-loop"
            (macro "block"
              (document (concat (render-loop) (no-page-break))
                (indent (document (arg "block")))
                (concat (render-end-loop) (right-flush))
              ) ;document
            ) ;macro
          ) ;assign
          ""
          (assign "algo-body"
            (macro "block"
              (document (concat (render-do) (no-page-break))
                (indent (document (arg "block")))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-begin"
            (macro "block"
              (document (concat (render-begin) (no-page-break))
                (indent (document (arg "block")))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-inputs"
            (macro "block"
              (document (concat (render-inputs) (no-page-break))
                (indent (document (arg "block")))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-outputs"
            (macro "block"
              (document (concat (render-outputs) (no-page-break))
                (indent (document (arg "block")))
              ) ;document
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "If-then-else statements"))))
          (assign "algo-if"
            (macro "cond"
              "body"
              (document (concat (render-if) " " (arg "cond") " " (render-then) (no-page-break))
                (indent (arg "body"))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-else-if"
            (macro "cond"
              "body"
              (document (concat (render-else)
                          " "
                          (render-if)
                          " "
                          (arg "cond")
                          " "
                          (render-then)
                          (no-page-break)
                        ) ;concat
                (indent (arg "body"))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-else"
            (macro "body"
              (document (concat (render-else) (no-page-break)) (indent (arg "body")))
            ) ;macro
          ) ;assign
          (assign "algo-make-if-else-if"
            (macro "args"
              (document (compound (if (equal (length (arg "args")) "0")
                                    "algo-null"
                                    (compound (if (equal (length (arg "args")) "1")
                                                "algo-else"
                                                (compound (if (greatereq (length (arg "args")) "2") "algo-else-if" "algo-null")
                                                  (look-up (arg "args") "0")
                                                  (look-up (arg "args") "1")
                                                ) ;compound
                                              ) ;if
                                      (look-up (arg "args") "0")
                                    ) ;compound
                                  ) ;if
                        ) ;compound
                (compound (if (greater (length (arg "args")) "2")
                            "algo-make-if-else-if"
                            (concat (render-end-if) (right-flush))
                          ) ;if
                  (range (arg "args") "2" (length (arg "args")))
                ) ;compound
              ) ;document
            ) ;macro
          ) ;assign
          (assign "algo-if-else-if"
            (xmacro "test-seq"
              (document (algo-if (arg "test-seq" "0") (arg "test-seq" "1"))
                (with "args"
                  (map-args "identity" "tuple" "test-seq")
                  "arity"
                  (length (map-args "identity" "tuple" "test-seq"))
                  (document (compound (if (greater (arity) "2") "algo-make-if-else-if" "render-end-if")
                              (range (value "args") "2" (arity))
                            ) ;compound
                  ) ;document
                ) ;with
              ) ;document
            ) ;xmacro
          ) ;assign
          (active* (document (src-comment (document "Constructs with inline arguments"))))
          (assign "algo-require"
            (macro "body" (surround (concat (render-require) " ") "" (arg "body")))
          ) ;assign
          (assign "algo-data"
            (macro "body" (surround (concat (render-data) " ") "" (arg "body")))
          ) ;assign
          (assign "algo-result"
            (macro "body" (surround (concat (render-result) " ") "" (arg "body")))
          ) ;assign
          (assign "algo-ensure"
            (macro "body" (surround (concat (render-ensure) " ") "" (arg "body")))
          ) ;assign
          (assign "algo-return"
            (macro "body" (surround (concat (render-return) " ") "" (arg "body")))
          ) ;assign
          (assign "algo-print"
            (macro "body" (surround (concat (render-print) " ") "" (arg "body")))
          ) ;assign
          (active* (document (src-comment (document "Simple keywords"))))
          (assign "algo-and" (macro (render-and)))
          (assign "algo-or" (macro (render-or)))
          (assign "algo-xor" (macro (render-xor)))
          (assign "algo-not" (macro (render-not)))
          (assign "algo-true" (macro (render-true)))
          (assign "algo-false" (macro (render-false)))
          (assign "algo-to" (macro (render-to)))
          (assign "algo-globals" (macro (render-globals)))
          (active* (document (src-comment (document "Miscellaneous constructs for pseudo-code")))
          ) ;active*
          (assign "render-new-line" (macro ""))
          (assign "render-inc-indent"
            (macro (assign "par-left" (plus (value "par-left") "1.5fn")))
          ) ;assign
          (assign "render-dec-indent"
            (macro (assign "par-left" (plus (value "par-left") "1.5fn")))
          ) ;assign
          (assign "algo-number-label" (macro "lab" (label (arg "lab"))))
          (assign "algo-label" (macro "lab" (label (arg "lab"))))
          (assign "algo-comment"
            (macro "body"
              (with "font-shape" "italic" "color" "dark grey" (concat "{" (arg "body") "}"))
            ) ;macro
          ) ;assign
          (assign "algo-comment"
            (macro "body"
              (with "color"
                "dark grey"
                (concat "{" (with "font-shape" "italic" (arg "body")) "}")
              ) ;with
            ) ;macro
          ) ;assign
          (assign "algo-state" (macro "body" (arg "body")))
          (assign "algo-call"
            (macro "name"
              "args"
              (document (concat (with "font-shape" "small-caps" (arg "name")) "(" (arg "args") ")")
              ) ;document
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Defining new keywords, functions, etc. for algorithms"))
                   ) ;document
          ) ;active*
          (assign "algo-new-keyword"
            (macro "name" "body" (assign (arg "name") (render-keyword (arg "body"))))
          ) ;assign
          (assign "algo-new-function"
            (macro "name"
              "body"
              (quasiquote
                (style-with "src-compact"
                  "none"
                  (concat (assign (arg "name")
                            (macro (concat (render-keyword* (concat (unquote (arg "body")) ":")) " "))
                          ) ;assign
                    (assign (merge (arg "name") "*")
                      (macro "x"
                        (surround (concat (render-keyword* (concat (unquote (arg "body")) ":")) " ")
                          ""
                          (arg "x")
                        ) ;surround
                      ) ;macro
                    ) ;assign
                  ) ;concat
                ) ;style-with
              ) ;quasiquote
            ) ;macro
          ) ;assign
          (assign "algo-new-data"
            (macro "name"
              "body"
              (quasiquote
                (style-with "src-compact"
                  "none"
                  (concat (assign (arg "name")
                            (macro (concat (render-keyword* (concat (unquote (arg "body")) ":")) " "))
                          ) ;assign
                    (assign (merge (arg "name") "*")
                      (macro "x"
                        (surround (concat (render-keyword* (concat (unquote (arg "body")) ":")) " ")
                          ""
                          (arg "x")
                        ) ;surround
                      ) ;macro
                    ) ;assign
                  ) ;concat
                ) ;style-with
              ) ;quasiquote
            ) ;macro
          ) ;assign
          (assign "algo-new-input"
            (macro "name"
              "body"
              (quasiquote
                (assign (arg "name")
                  (macro "x"
                    (surround (concat (render-keyword* (concat (unquote (arg "body")) ":")) " ")
                      ""
                      (arg "x")
                    ) ;surround
                  ) ;macro
                ) ;assign
              ) ;quasiquote
            ) ;macro
          ) ;assign
          (assign "algo-new-in-out"
            (macro "name"
              "body"
              (quasiquote
                (assign (arg "name")
                  (macro "x"
                    (surround (concat (render-keyword* (concat (unquote (arg "body")) ":")) " ")
                      ""
                      (arg "x")
                    ) ;surround
                  ) ;macro
                ) ;assign
              ) ;quasiquote
            ) ;macro
          ) ;assign
        ) ;document
  ) ;body
  (initial (collection (associate "preamble" "true") (associate "sfactor" "5")))
) ;document
