;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(document (TeXmacs "2.1.4")
  (style "source")
  (body (document (active* (src-title (document (src-package "env-float" "1.0")
                                        (src-purpose (document "Environments for floating content."))
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (active* (document (src-comment (document "Style parameters"))))
          (assign "figure-width" "1par")
          (assign "figure-left-padding" "0spc")
          (assign "figure-right-padding" "0spc")
          (assign "figure-caption-sep" "0.5fn")
          (assign "caption-left-padding" "1.5fn")
          (assign "caption-right-padding" "1.5fn")
          ""
          (assign "figure-name" (macro "name" (with "font-series" "bold" (arg "name"))))
          (assign "figure-sep" (macro ". "))
          (assign "table-sep" (macro ". "))
          (assign "footnote-sep" (macro ". "))
          ""
          (drd-props "figure-sep" "macro-parameter" "string")
          (drd-props "table-sep" "macro-parameter" "string")
          (drd-props "footnote-sep" "macro-parameter" "string")
          (active* (document (src-comment (document "Detailed and summarized captions"))))
          (assign "caption-detailed" (macro "long" "short" (document (arg "long"))))
          (assign "caption-summarized" (macro "long" "short" (document (arg "short"))))
          (drd-props "caption-detailed" "arity" "2" "accessible" "0" "border" "no")
          (drd-props "caption-summarized" "arity" "2" "accessible" "1" "border" "no")
          (assign "list-prefix"
            (macro "type"
              (if (provides (merge (arg "type") "-list-prefix"))
                (value (merge (arg "type") "-list-prefix"))
                (arg "type")
              ) ;if
            ) ;macro
          ) ;assign
          (assign "list-caption"
            (macro "type"
              "cap"
              (with "caption-detailed"
                (value "caption-summarized")
                (style-with "src-compact"
                  "none"
                  (concat (auto-label)
                    (write (list-prefix (arg "type"))
                      (tuple "normal" (arg "cap") (pageref (the-auto)))
                    ) ;write
                  ) ;concat
                ) ;style-with
              ) ;with
            ) ;macro
          ) ;assign
          (assign "render-caption"
            (macro "type"
              "name"
              "cap"
              (document (html-div-class "caption"
                          (document (small (surround (concat (figure-name (concat (arg "name") (if (equal (arg "type") "table") (table-sep) (figure-sep)))
                                                             ) ;figure-name
                                                       (list-caption (arg "type") (arg "cap"))
                                                     ) ;concat
                                             ""
                                             (document (arg "cap"))
                                           ) ;surround
                                    ) ;small
                          ) ;document
                        ) ;html-div-class
              ) ;document
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Figure-like environments."))))
          (assign "render-small-figure"
            (macro "type"
              "name"
              "fig"
              "cap"
              (tabular* (tformat (cwith "1" "-1" "1" "-1" "cell-lsep" "0spc")
                          (cwith "1" "-1" "1" "-1" "cell-rsep" "0spc")
                          (cwith "2" "2" "1" "1" "cell-height" "0.5fn")
                          (twith "table-valign" "B")
                          (cwith "3" "3" "1" "1" "cell-hyphen" "t")
                          (twith "table-width" "1par")
                          (twith "table-hmode" "min")
                          (table (row (cell (resize (arg "fig") (minus "1l" "2fn") "" (plus "1r" "2fn") "")))
                            (row (cell ""))
                            (row (cell (document (render-caption (arg "type") (arg "name") (arg "cap")))))
                          ) ;table
                        ) ;tformat
              ) ;tabular*
            ) ;macro
          ) ;assign
          (assign "render-big-figure"
            (macro "type"
              "name"
              "fig"
              "cap"
              (document (padded-normal "1fn"
                          "1fn"
                          (tabular* (tformat (twith "table-width" (value "figure-width"))
                                      (cwith "3" "3" "1" "1" "cell-hyphen" "t")
                                      (cwith "1" "-1" "1" "-1" "cell-lsep" (value "figure-left-padding"))
                                      (cwith "1" "-1" "1" "-1" "cell-rsep" (value "figure-right-padding"))
                                      (cwith "2" "2" "1" "1" "cell-height" (value "figure-caption-sep"))
                                      (cwith "3" "3" "1" "1" "cell-lsep" (value "caption-left-padding"))
                                      (cwith "3" "3" "1" "1" "cell-rsep" (value "caption-right-padding"))
                                      (table (row (cell (arg "fig")))
                                        (row (cell ""))
                                        (row (cell (document (render-caption (arg "type") (arg "name") (arg "cap")))))
                                      ) ;table
                                    ) ;tformat
                          ) ;tabular*
                        ) ;padded-normal
              ) ;document
            ) ;macro
          ) ;assign
          (assign "render-small-table"
            (macro "type"
              "name"
              "fig"
              "cap"
              (tabular* (tformat (cwith "1" "-1" "1" "-1" "cell-lsep" "0spc")
                          (cwith "1" "-1" "1" "-1" "cell-rsep" "0spc")
                          (cwith "2" "2" "1" "1" "cell-height" "0.5fn")
                          (twith "table-valign" "B")
                          (cwith "3" "3" "1" "1" "cell-hyphen" "t")
                          (twith "table-width" "1par")
                          (twith "table-hmode" "min")
                          (table (row (cell (resize (arg "fig") (minus "1l" "2fn") "" (plus "1r" "2fn") "")))
                            (row (cell ""))
                            (row (cell (document (render-caption (arg "type") (arg "name") (arg "cap")))))
                          ) ;table
                        ) ;tformat
              ) ;tabular*
            ) ;macro
          ) ;assign
          (assign "render-big-table"
            (macro "type"
              "name"
              "fig"
              "cap"
              (document (padded-normal "1fn"
                          "1fn"
                          (tabular* (tformat (twith "table-width" (value "figure-width"))
                                      (cwith "3" "3" "1" "1" "cell-hyphen" "t")
                                      (cwith "1" "-1" "1" "-1" "cell-lsep" (value "figure-left-padding"))
                                      (cwith "1" "-1" "1" "-1" "cell-rsep" (value "figure-right-padding"))
                                      (cwith "2" "2" "1" "1" "cell-height" (value "figure-caption-sep"))
                                      (cwith "3" "3" "1" "1" "cell-lsep" (value "caption-left-padding"))
                                      (cwith "3" "3" "1" "1" "cell-rsep" (value "caption-right-padding"))
                                      (table (row (cell (arg "fig")))
                                        (row (cell ""))
                                        (row (cell (document (render-caption (arg "type") (arg "name") (arg "cap")))))
                                      ) ;table
                                    ) ;tformat
                          ) ;tabular*
                        ) ;padded-normal
              ) ;document
            ) ;macro
          ) ;assign
          (assign "figure-list-prefix" "figure")
          (assign "with-figure-list"
            (macro "lof" "body" (with "figure-list-prefix" (arg "lof") (arg "body")))
          ) ;assign
          (assign "table-list-prefix" "table")
          (assign "with-table-list"
            (macro "lot" "body" (with "table-list-prefix" (arg "lot") (arg "body")))
          ) ;assign
          (new-figure "figure" "Figure")
          (new-table "table" "Table")
          (active* (document (src-comment (document "Footnotes."))))
          (assign "render-footnote*"
            (macro "sym"
              "nr"
              "body"
              (style-with "src-compact"
                "none"
                (float "footnote"
                  ""
                  (document (style-with "src-compact"
                              "none"
                              (document (smaller (with "par-mode"
                                                   "justify"
                                                   "par-left"
                                                   "0cm"
                                                   "par-right"
                                                   "0cm"
                                                   "font-shape"
                                                   "right"
                                                   "dummy"
                                                   (value "page-fnote-sep")
                                                   "dummy"
                                                   (value "page-fnote-barlen")
                                                   (style-with "src-compact"
                                                     "none"
                                                     (surround (concat (locus (id (hard-id (arg "body")))
                                                                         (link "hyperlink"
                                                                           (id (hard-id (arg "body")))
                                                                           (url (merge "#footnr-" (arg "nr")))
                                                                         ) ;link
                                                                         (arg "sym")
                                                                       ) ;locus
                                                                 (footnote-sep)
                                                               ) ;concat
                                                       (concat (set-binding (merge "footnote-" (arg "nr")) (value "the-label") "body")
                                                         (right-flush)
                                                       ) ;concat
                                                       (style-with "src-compact" "none" (arg "body"))
                                                     ) ;surround
                                                   ) ;style-with
                                                 ) ;with
                                        ) ;smaller
                              ) ;document
                            ) ;style-with
                  ) ;document
                ) ;float
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "render-footnote"
            (macro "nr" "body" (render-footnote* (arg "nr") (arg "nr") (arg "body")))
          ) ;assign
          (assign "footnote"
            (macro "body"
              (style-with "src-compact"
                "none"
                (concat (next-footnote)
                  (render-footnote (the-footnote) (arg "body"))
                  (space "0spc")
                  (label (merge "footnr-" (the-footnote)))
                  (rsup (with "font-shape" "right" (reference (merge "footnote-" (the-footnote))))
                  ) ;rsup
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Customized notes."))))
          (assign "custom-note-text"
            (macro "sym"
              "id"
              "body"
              (document (style-with "src-compact"
                          "none"
                          (document (style-with "src-compact"
                                      "none"
                                      ""
                                      ""
                                      (surround (concat (locus (id (merge "dest-abbr-" (arg "id")))
                                                          (link "footnote-source"
                                                            (id (merge "dest-abbr-" (arg "id")))
                                                            (id (merge "source-" (arg "id")))
                                                          ) ;link
                                                          (arg "sym")
                                                        ) ;locus
                                                  (footnote-sep)
                                                ) ;concat
                                        ""
                                        (document (with "locus-color"
                                                    "preserve"
                                                    "visited-color"
                                                    "preserve"
                                                    (document (locus (id (merge "dest-" (arg "id")))
                                                                (document (style-with "src-compact" "none" (arg "body")))
                                                              ) ;locus
                                                    ) ;document
                                                  ) ;with
                                        ) ;document
                                      ) ;surround
                                    ) ;style-with
                          ) ;document
                        ) ;style-with
              ) ;document
            ) ;macro
          ) ;assign
          (assign "custom-footnote-text"
            (macro "sym"
              "id"
              "body"
              (style-with "src-compact"
                "none"
                (float "footnote"
                  ""
                  (document (smaller (with "par-mode"
                                       "justify"
                                       "par-left"
                                       "0cm"
                                       "par-right"
                                       "0cm"
                                       (document (custom-note-text (arg "sym")
                                                   (arg "id")
                                                   (document (surround "" (right-flush) (arg "body")))
                                                 ) ;custom-note-text
                                       ) ;document
                                     ) ;with
                            ) ;smaller
                  ) ;document
                ) ;float
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "custom-note-ref"
            (macro "sym"
              "sep"
              "id"
              "body"
              (style-with "src-compact"
                "none"
                (concat (with "locus-color"
                          "preserve"
                          "visited-color"
                          "preserve"
                          (locus (id (merge "source-" (arg "id"))) (arg "body"))
                        ) ;with
                  (math "")
                  (rsup (locus (id (merge "source-abbr-" (arg "id")))
                          (link "footnote-text"
                            (id (merge "source-abbr-" (arg "id")))
                            (id (merge "dest-" (arg "id")))
                          ) ;link
                          (concat (arg "sep") (arg "sym"))
                        ) ;locus
                  ) ;rsup
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Detached notes."))))
          (assign "render-inline-note"
            (macro "nr"
              "lab"
              "body"
              (smaller (surround (concat (locus (id (hard-id (arg "body")))
                                           (link "hyperlink"
                                             (id (hard-id (arg "body")))
                                             (url (merge "#footnr-" (arg "nr")))
                                           ) ;link
                                           (arg "nr")
                                         ) ;locus
                                   (footnote-sep)
                                 ) ;concat
                         (set-binding (merge "footnote-" (arg "nr")) (arg "lab") "body")
                         (style-with "src-compact" "none" (arg "body"))
                       ) ;surround
              ) ;smaller
            ) ;macro
          ) ;assign
          (assign "render-wide-note"
            (macro "nr"
              "lab"
              "body"
              (document (style-with "src-compact"
                          "none"
                          (document (smaller (with "par-mode"
                                               "justify"
                                               "par-left"
                                               "0cm"
                                               "par-right"
                                               "0cm"
                                               "font-shape"
                                               "right"
                                               "dummy"
                                               (value "page-fnote-sep")
                                               "dummy"
                                               (value "page-fnote-barlen")
                                               (style-with "src-compact"
                                                 "none"
                                                 (surround (concat (locus (id (hard-id (arg "body")))
                                                                     (link "hyperlink"
                                                                       (id (hard-id (arg "body")))
                                                                       (url (merge "#footnr-" (arg "nr")))
                                                                     ) ;link
                                                                     (arg "nr")
                                                                   ) ;locus
                                                             (footnote-sep)
                                                           ) ;concat
                                                   (concat (set-binding (merge "footnote-" (arg "nr")) (arg "lab") "body")
                                                     (right-flush)
                                                   ) ;concat
                                                   (style-with "src-compact" "none" (arg "body"))
                                                 ) ;surround
                                               ) ;style-with
                                             ) ;with
                                    ) ;smaller
                          ) ;document
                        ) ;style-with
              ) ;document
            ) ;macro
          ) ;assign
          ""
          (assign "note-declare"
            (macro "id"
              (if (not (provides (merge "fnote-" (arg "id"))))
                (concat (next-footnote)
                  (assign (merge "fnote-" (arg "id")) (the-footnote))
                  (assign (merge "fnlab-" (arg "id")) (value "the-label"))
                ) ;concat
              ) ;if
            ) ;macro
          ) ;assign
          (assign "note-declare*"
            (macro "id"
              "sym"
              (if (not (provides (merge "fnote-" (arg "id"))))
                (concat (assign (merge "fnote-" (arg "id")) (arg "sym"))
                  (assign (merge "fnlab-" (arg "id")) (arg "sym"))
                ) ;concat
              ) ;if
            ) ;macro
          ) ;assign
          (assign "note-ref"
            (macro "id"
              (concat (space "0spc")
                (note-declare (arg "id"))
                (label (merge "footnr-" (value (merge "fnote-" (arg "id")))))
                (rsup (with "font-shape"
                        "right"
                        (if (has-binding (merge "footnote-" (value (merge "fnote-" (arg "id")))))
                          (reference (merge "footnote-" (value (merge "fnote-" (arg "id")))))
                          (value (merge "fnlab-" (arg "id")))
                        ) ;if
                      ) ;with
                ) ;rsup
              ) ;concat
            ) ;macro
          ) ;assign
          (assign "note-ref*"
            (macro "id"
              "sym"
              (concat (space "0spc")
                (note-declare* (arg "id") (arg "sym"))
                (label (merge "footnr-" (value (merge "fnote-" (arg "id")))))
                (rsup (with "font-shape"
                        "right"
                        (if (has-binding (merge "footnote-" (value (merge "fnote-" (arg "id")))))
                          (reference (merge "footnote-" (value (merge "fnote-" (arg "id")))))
                          (value (merge "fnlab-" (arg "id")))
                        ) ;if
                      ) ;with
                ) ;rsup
              ) ;concat
            ) ;macro
          ) ;assign
          (assign "note-inline"
            (macro "body"
              "id"
              (surround (note-declare (arg "id"))
                ""
                (render-inline-note (value (merge "fnote-" (arg "id")))
                  (value (merge "fnlab-" (arg "id")))
                  (arg "body")
                ) ;render-inline-note
              ) ;surround
            ) ;macro
          ) ;assign
          (assign "note-inline*"
            (macro "body"
              "id"
              "sym"
              (surround (note-declare* (arg "id") (arg "sym"))
                ""
                (render-inline-note (value (merge "fnote-" (arg "id")))
                  (value (merge "fnlab-" (arg "id")))
                  (arg "body")
                ) ;render-inline-note
              ) ;surround
            ) ;macro
          ) ;assign
          (assign "note-wide"
            (macro "body"
              "id"
              (surround (note-declare (arg "id"))
                ""
                (render-wide-note (value (merge "fnote-" (arg "id")))
                  (value (merge "fnlab-" (arg "id")))
                  (arg "body")
                ) ;render-wide-note
              ) ;surround
            ) ;macro
          ) ;assign
          (assign "note-wide*"
            (macro "body"
              "id"
              "sym"
              (surround (note-declare* (arg "id") (arg "sym"))
                ""
                (render-wide-note (value (merge "fnote-" (arg "id")))
                  (value (merge "fnlab-" (arg "id")))
                  (arg "body")
                ) ;render-wide-note
              ) ;surround
            ) ;macro
          ) ;assign
          (assign "note-footnote"
            (macro "body"
              "id"
              (surround (concat (note-declare (arg "id")) (flag "Footnote" "brown"))
                ""
                (with "the-label"
                  (value (merge "fnlab-" (arg "id")))
                  (render-footnote (value (merge "fnote-" (arg "id"))) (arg "body"))
                ) ;with
              ) ;surround
            ) ;macro
          ) ;assign
          (assign "note-footnote*"
            (macro "body"
              "id"
              "sym"
              (surround (concat (note-declare* (arg "id") (arg "sym")) (flag "Footnote" "brown"))
                ""
                (with "the-label"
                  (value (merge "fnlab-" (arg "id")))
                  (render-footnote (value (merge "fnote-" (arg "id"))) (arg "body"))
                ) ;with
              ) ;surround
            ) ;macro
          ) ;assign
          ""
          (drd-props "note-declare" "arity" "1" "unaccessible" "0" "identifier" "0")
          (drd-props "note-declare*" "arity" "2" "unaccessible" "all" "identifier" "0")
          (drd-props "note-ref" "arity" "1" "unaccessible" "0" "identifier" "0")
          (drd-props "note-ref*" "arity" "2" "unaccessible" "0" "identifier" "0"
            "unaccessible" "1"
          ) ;drd-props
          (drd-props "note-inline" "arity" "2" "accessible" "0" "unaccessible"
            "1" "identifier" "1"
          ) ;drd-props
          (drd-props "note-inline*" "arity" "3" "accessible" "0" "unaccessible"
            "1" "unaccessible" "2" "identifier" "1"
          ) ;drd-props
          (drd-props "note-wide" "arity" "2" "accessible" "0" "unaccessible" "1"
            "identifier" "1"
          ) ;drd-props
          (drd-props "note-wide*" "arity" "3" "accessible" "0" "unaccessible"
            "1" "unaccessible" "2" "identifier" "1"
          ) ;drd-props
          (drd-props "note-footnote" "arity" "2" "accessible" "0" "unaccessible"
            "1" "identifier" "1"
          ) ;drd-props
          (drd-props "note-footnote*" "arity" "3" "accessible" "0"
            "unaccessible" "1" "unaccessible" "2" "identifier" "1"
          ) ;drd-props
          (active* (document (src-comment (document "Legacy macros."))))
          (assign "footnote-new" (value "note-declare"))
          (assign "footnote-reference" (value "note-ref"))
          (assign "footnote-text" (value "note-footnote"))
          (assign "footnote-show" (value "note-wide"))
          (drd-props "footnote-new" "arity" "1" "unaccessible" "0" "identifier" "0")
          (drd-props "footnote-reference" "arity" "1" "unaccessible" "0" "identifier" "0")
          (drd-props "footnote-text" "arity" "2" "accessible" "0" "unaccessible"
            "1" "identifier" "1"
          ) ;drd-props
          (drd-props "footnote-show" "arity" "2" "accessible" "0" "unaccessible"
            "1" "identifier" "1"
          ) ;drd-props
          (active* (document (src-comment (document "Wide variants."))))
          (assign "wide-footnote"
            (macro "body" (with "par-columns" "1" (footnote (arg "body"))))
          ) ;assign
          (assign "wide-float"
            (macro "type"
              "pos"
              "body"
              (concat (flag "wide float" "dark brown")
                (with "par-columns" "1" (float (arg "type") (arg "pos") (arg "body")))
              ) ;concat
            ) ;macro
          ) ;assign
        ) ;document
  ) ;body
  (initial (collection (associate "preamble" "true")))
) ;document
