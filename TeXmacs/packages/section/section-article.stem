(document (TeXmacs "1.99.9")
  (style "source")
  (body (document (active* (src-title (document (src-package "section-article" "1.0")
                                        (src-purpose (document "Sectional markup for articles."))
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (use-package "section/section-base")
          (active* (document (src-comment (document "Parts and chapters."))))
          (assign "part-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (sectional-centered-bold (concat (vspace* "5fn") (really-huge (arg "name")) (vspace "2fn"))
                ) ;sectional-centered-bold
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "chapter-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (chapter-title-render (concat (vspace* "4fn") (huge (arg "name")) (vspace "1.5fn"))
                ) ;chapter-title-render
              ) ;style-with
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Sections."))))
          (assign "section-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (section-title-render (concat (vspace* "3fn") (very-large (arg "name")) (vspace "1fn"))
                ) ;section-title-render
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "appendix-title"
            (macro "title"
              (style-with "src-compact"
                "none"
                (section-title (concat (appendix-text) (sectional-sep) (arg "title")))
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "appendix-numbered-title"
            (macro "title"
              (style-with "src-compact"
                "none"
                (section-title (concat (appendix-text) " " (the-appendix) (sectional-sep) (arg "title"))
                ) ;section-title
              ) ;style-with
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Subsections and subsubsections."))))
          (assign "subsection-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (subsection-title-render (concat (vspace* "2fn") (large (arg "name")) (vspace "0.5fn"))
                ) ;subsection-title-render
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "subsubsection-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (subsubsection-title-render (concat (vspace* "1fn") (arg "name") (vspace "0.5fn"))
                ) ;subsubsection-title-render
              ) ;style-with
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Paragraphs and subparagraphs."))))
          (assign "paragraph-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (sectional-short-bold (concat (vspace* "0.5fn") (arg "name")))
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "subparagraph-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (sectional-short-bold (concat (vspace* "0.25fn") (arg "name")))
              ) ;style-with
            ) ;macro
          ) ;assign
          ""
        ) ;document
  ) ;body
  (initial (collection (associate "preamble" "true")))
) ;document
