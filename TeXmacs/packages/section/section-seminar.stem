(document (TeXmacs "1.99.9")
  (style "source")
  (body (document (active* (src-title (document (src-package "section-seminar" "1.0")
                                        (src-purpose (document "Sectional markup for the seminar style."))
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (use-package "section/section-base")
          (active* (document (src-comment (document "Parts and chapters."))))
          (assign "part-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (sectional-centered-bold (concat (vspace* "3fn")
                                           (with "color" "dark magenta" (really-huge (arg "name")))
                                           (vspace "1.5fn")
                                         ) ;concat
                ) ;sectional-centered-bold
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "chapter-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (sectional-normal-bold (concat (vspace* "2fn")
                                         (with "color" "dark magenta" (huge (arg "name")))
                                         (vspace "1fn")
                                       ) ;concat
                ) ;sectional-normal-bold
              ) ;style-with
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Sections, subsections and subsubsections.")))
          ) ;active*
          (assign "section-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (sectional-normal-bold (concat (vspace* "1.5fn")
                                         (with "color" "red" (very-large (arg "name")))
                                         (vspace "0.75fn")
                                       ) ;concat
                ) ;sectional-normal-bold
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "subsection-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (sectional-normal-bold (concat (vspace* "1fn")
                                         (with "color" "red" (large (arg "name")))
                                         (vspace "0.5fn")
                                       ) ;concat
                ) ;sectional-normal-bold
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "subsubsection-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (sectional-normal-bold (concat (vspace* "0.5fn") (with "color" "red" (arg "name")) (vspace "0.25fn"))
                ) ;sectional-normal-bold
              ) ;style-with
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Paragraphs and subparagraphs."))))
          (assign "paragraph-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (sectional-short-bold (concat (vspace* "0.5fn") (arg "name")))
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "subparagraph-title"
            (macro "name"
              (style-with "src-compact"
                "none"
                (sectional-short-bold (concat (vspace* "0.25fn") (arg "name")))
              ) ;style-with
            ) ;macro
          ) ;assign
          ""
        ) ;document
  ) ;body
  (initial (collection (associate "preamble" "true")))
) ;document
