(document (TeXmacs "2.1.4")
  (style (tuple "source"))
  (body (document (active* (src-title (document (src-package "preview-ref" "1.0")
                                        (src-purpose (document "Show preview of link destination for references and citations")
                                        ) ;src-purpose
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (use-module "(link ref-edit)")
          (assign "reference"
            (macro "Id"
              (locus (id (hard-id (arg "Id")))
                (link "hyperlink" (id (hard-id (arg "Id"))) (url (merge "#" (arg "Id"))))
                (link "mouse-over"
                  (id (hard-id (arg "Id")))
                  (script "preview-reference" (quote-arg "Id") (arg "Id"))
                ) ;link
                (get-binding (arg "Id"))
              ) ;locus
            ) ;macro
          ) ;assign
          (assign "pageref"
            (macro "Id"
              (locus (id (hard-id (arg "Id")))
                (link "hyperlink" (id (hard-id (arg "Id"))) (url (merge "#" (arg "Id"))))
                (link "mouse-over"
                  (id (hard-id (arg "Id")))
                  (script "preview-reference" (quote-arg "Id") (arg "Id"))
                ) ;link
                (get-binding (arg "Id") "1")
              ) ;locus
            ) ;macro
          ) ;assign
        ) ;document
  ) ;body
  (initial (collection (associate "preamble" "true")))
) ;document
