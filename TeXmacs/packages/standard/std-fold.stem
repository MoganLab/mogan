;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(document (TeXmacs "2.1.2")
  (style (tuple "source" "std"))
  (body (document (active* (src-title (document (src-package "std-fold" "1.0")
                                        (src-purpose (document "Macros for folding and switches."))
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (active* (document (src-comment (document "Customizable and shown content."))))
          (assign "hidden*" (macro "body" (hidden (arg "body"))))
          (assign "shown*" (macro "body" (arg "body")))
          (drd-props "hidden*" "arity" "1" "hidden" "all" "unaccessible" "all"
            "border" "no"
          ) ;drd-props
          (assign "hidden-deleted"
            (macro "body" (with "hidden*" (macro "x" (hidden (arg "x"))) (arg "body")))
          ) ;assign
          (assign "hidden-invisible"
            (macro "body"
              (with "hidden*" (macro "x" (with "opacity" "0" (arg "x"))) (arg "body"))
            ) ;macro
          ) ;assign
          (assign "hidden-greyed"
            (macro "body"
              (with "hidden*" (macro "x" (with "opacity" "0.1" (arg "x"))) (arg "body"))
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Rendering folding tags."))))
          (assign "unfold-button"
            (macro "body" "x" (action (arg "body") "mouse-unfold" (arg "x")))
          ) ;assign
          (assign "fold-button"
            (macro "body" "x" (action (arg "body") "mouse-fold" (arg "x")))
          ) ;assign
          (assign "render-folded-std"
            (macro "button"
              "body"
              (document (with "par-left"
                          (plus (value "par-left") "1.5fn")
                          (style-with "src-compact"
                            "none"
                            (surround (concat (with "par-first" "-1.5fn" (yes-indent)) (arg "button"))
                              (hflush)
                              (document (arg "body"))
                            ) ;surround
                          ) ;style-with
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (assign "default-padded-normal" (value "padded-normal"))
          (assign "folded-padded-normal"
            (macro "before"
              "after"
              "body"
              (surround (vspace* (arg "before"))
                (concat (htab "0fn" "first") (vspace (arg "after")))
                (document (with "padded-normal" (value "default-padded-normal") (document (arg "body")))
                ) ;document
              ) ;surround
            ) ;macro
          ) ;assign
          (assign "render-folded-env"
            (macro "button"
              "body"
              (document (surround (with "par-first" "-1.5fn" (concat (yes-indent) (arg "button")))
                          (right-flush)
                          (document (with "default-padded-normal"
                                      (value "padded-normal")
                                      "padded-normal"
                                      (value "folded-padded-normal")
                                      (document (arg "body"))
                                    ) ;with
                          ) ;document
                        ) ;surround
              ) ;document
            ) ;macro
          ) ;assign
          (assign "render-folded-explain"
            (macro "title"
              "body"
              (document (surround (concat (no-indent) (vspace* "0.5fn"))
                          (concat (vspace "0.5fn") (right-flush))
                          (document (concat (with "font-series" "bold" (arg "title")) (vspace "0.5fn"))
                            (arg "body")
                          ) ;document
                        ) ;surround
              ) ;document
            ) ;macro
          ) ;assign
          (assign "render-folded-documentation"
            (macro "button"
              "body1"
              "body2"
              (document (surround (vspace* "1fn")
                          (concat (right-flush) (arg "button") (vspace "0.25fn"))
                          (document (arg "body1"))
                        ) ;surround
                (hidden (arg "body2"))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "render-unfolded-documentation"
            (macro "button"
              "body1"
              "body2"
              (document (surround (vspace* "1fn")
                          (concat (right-flush) (arg "button") (vspace "0.25fn"))
                          (document (arg "body1"))
                        ) ;surround
                (arg "body2")
              ) ;document
            ) ;macro
          ) ;assign
          (assign "render-folded-grouped"
            (macro "button"
              "body"
              (document (with "old-color"
                          (value "color")
                          "color"
                          "blue"
                          (document (tabular (tformat (twith "table-width" "1par")
                                               (twith "table-hmode" "exact")
                                               (cwith "1" "1" "2" "2" "cell-hpart" "1")
                                               (cwith "1" "1" "1" "1" "cell-lsep" "0ln")
                                               (cwith "1" "1" "1" "1" "cell-rsep" "0ln")
                                               (cwith "1" "1" "1" "1" "cell-bsep" "0ln")
                                               (cwith "1" "1" "1" "1" "cell-tsep" "0ln")
                                               (cwith "1" "1" "1" "1" "cell-width" "20ln")
                                               (cwith "1" "1" "1" "1" "cell-hmode" "exact")
                                               (cwith "1" "1" "2" "2" "cell-hyphen" "t")
                                               (table (row (cell (subtable (tformat (cwith "1" "-1" "1" "-1" "cell-background" "pastel blue")
                                                                             (cwith "2" "2" "2" "2" "cell-background" "")
                                                                             (cwith "1" "-1" "1" "1" "cell-lborder" "0.5ln")
                                                                             (cwith "1" "1" "1" "-1" "cell-tborder" "0.5ln")
                                                                             (cwith "3" "3" "1" "-1" "cell-bborder" "0.5ln")
                                                                             (cwith "3" "3" "2" "2" "cell-rborder" "0.5ln")
                                                                             (cwith "3" "3" "2" "2" "cell-tborder" "0.5ln")
                                                                             (cwith "1" "1" "2" "2" "cell-rborder" "0.5ln")
                                                                             (cwith "1" "1" "2" "2" "cell-bborder" "0.5ln")
                                                                             (cwith "2" "2" "1" "1" "cell-rborder" "0.5ln")
                                                                             (cwith "1" "-1" "2" "2" "cell-width" "6ln")
                                                                             (cwith "1" "-1" "2" "2" "cell-hmode" "exact")
                                                                             (cwith "1" "-1" "1" "-1" "cell-lsep" "0ln")
                                                                             (cwith "1" "-1" "1" "-1" "cell-rsep" "0ln")
                                                                             (cwith "1" "-1" "1" "-1" "cell-bsep" "0ln")
                                                                             (cwith "1" "-1" "1" "-1" "cell-tsep" "0ln")
                                                                             (cwith "2" "2" "1" "1" "cell-halign" "l")
                                                                             (cwith "1" "-1" "1" "-1" "cell-vcorrect" "n")
                                                                             (cwith "2" "2" "1" "-1" "cell-vpart" "1")
                                                                             (cwith "1" "-1" "2" "2" "cell-hpart" "1")
                                                                             (cwith "1" "-1" "1" "1" "cell-width" "6ln")
                                                                             (cwith "1" "-1" "1" "1" "cell-hmode" "exact")
                                                                             (cwith "3" "3" "1" "-1" "cell-height" "6ln")
                                                                             (cwith "3" "3" "1" "-1" "cell-vmode" "exact")
                                                                             (cwith "1" "1" "1" "-1" "cell-height" "6ln")
                                                                             (cwith "1" "1" "1" "-1" "cell-vmode" "exact")
                                                                             (cwith "1" "-1" "1" "-1" "cell-valign" "c")
                                                                             (table (row (cell (arg "button")) (cell (arg "button")))
                                                                               (row (cell (arg "button")) (cell (arg "button")))
                                                                               (row (cell (arg "button")) (cell (arg "button")))
                                                                             ) ;table
                                                                           ) ;tformat
                                                                 ) ;subtable
                                                           ) ;cell
                                                        (cell (document (with "color" (value "old-color") (document (arg "body")))))
                                                      ) ;row
                                               ) ;table
                                             ) ;tformat
                                    ) ;tabular
                          ) ;document
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Tags for folding and unfolding."))))
          (assign "folded-plain"
            (macro "x"
              "y"
              (document (surround "" (right-flush) (document (arg "x") (hidden (arg "y")))))
            ) ;macro
          ) ;assign
          (assign "unfolded-plain"
            (macro "x"
              "y"
              (document (surround "" (right-flush) (document (arg "x") (arg "y"))))
            ) ;macro
          ) ;assign
          (assign "folded-std"
            (macro "x"
              "y"
              (document (render-folded-std (unfold-button (resize (active* (with "mode" "math" (op "<circ>")))
                                                            ""
                                                            ""
                                                            (maximum "1r" "1.5fn")
                                                            ""
                                                          ) ;resize
                                             (arg "x")
                                           ) ;unfold-button
                          (document (arg "x") (hidden (arg "y")))
                        ) ;render-folded-std
              ) ;document
            ) ;macro
          ) ;assign
          (assign "unfolded-std"
            (macro "x"
              "y"
              (document (render-folded-std (fold-button (resize (active* (with "mode" "math" "<bullet>"))
                                                          ""
                                                          ""
                                                          (maximum "1r" "1.5fn")
                                                          ""
                                                        ) ;resize
                                             (arg "x")
                                           ) ;fold-button
                          (document (arg "x") (arg "y"))
                        ) ;render-folded-std
              ) ;document
            ) ;macro
          ) ;assign
          (assign "folded-reverse"
            (macro "x"
              "y"
              (document (hidden (arg "x"))
                (render-folded-std (unfold-button (resize (active* (with "mode" "math" (op "<circ>")))
                                                    ""
                                                    ""
                                                    (maximum "1r" "1.5fn")
                                                    ""
                                                  ) ;resize
                                     (arg "y")
                                   ) ;unfold-button
                  (document (arg "y"))
                ) ;render-folded-std
              ) ;document
            ) ;macro
          ) ;assign
          (assign "unfolded-reverse"
            (macro "x"
              "y"
              (document (render-folded-std (resize "" "" "" "1.5fn" "") (document (arg "x")))
                (render-folded-std (fold-button (resize (active* (with "mode" "math" "<bullet>"))
                                                  ""
                                                  ""
                                                  (maximum "1r" "1.5fn")
                                                  ""
                                                ) ;resize
                                     (arg "y")
                                   ) ;fold-button
                  (document (arg "y"))
                ) ;render-folded-std
              ) ;document
            ) ;macro
          ) ;assign
          (assign "folded-env"
            (macro "x"
              "y"
              (document (render-folded-env (unfold-button (resize (specific "screen" (active* (with "mode" "math" (op "<circ>"))))
                                                            ""
                                                            ""
                                                            (maximum "1r" "1.5fn")
                                                            ""
                                                          ) ;resize
                                             (arg "x")
                                           ) ;unfold-button
                          (document (arg "x") (hidden (arg "y")))
                        ) ;render-folded-env
              ) ;document
            ) ;macro
          ) ;assign
          (assign "unfolded-env"
            (macro "x"
              "y"
              (document (render-folded-env (fold-button (resize (specific "screen" (active* (with "mode" "math" "<bullet>")))
                                                          ""
                                                          ""
                                                          (maximum "1r" "1.5fn")
                                                          ""
                                                        ) ;resize
                                             (arg "x")
                                           ) ;fold-button
                          (document (arg "x") (arg "y"))
                        ) ;render-folded-env
              ) ;document
            ) ;macro
          ) ;assign
          (assign "folded-explain"
            (macro "x"
              "y"
              (document (render-folded-explain (with "color*"
                                                 (value "color")
                                                 (action (with "color" (value "color*") (arg "x")) "mouse-unfold" (arg "x"))
                                               ) ;with
                          (document (hidden (arg "y")))
                        ) ;render-folded-explain
              ) ;document
            ) ;macro
          ) ;assign
          (assign "unfolded-explain"
            (macro "x"
              "y"
              (document (render-folded-explain (with "color*"
                                                 (value "color")
                                                 (action (with "color" (value "color*") (arg "x")) "mouse-fold" (arg "x"))
                                               ) ;with
                          (document (arg "y"))
                        ) ;render-folded-explain
              ) ;document
            ) ;macro
          ) ;assign
          (assign "folded-documentation"
            (macro "x"
              "y"
              (document (render-folded-documentation (unfold-button (with "color" "#336666" (strong (large (math (op "<Downarrow>")))))
                                                       (arg "x")
                                                     ) ;unfold-button
                          (document (strong (large (arg "x"))))
                          (document (hidden (arg "y")))
                        ) ;render-folded-documentation
              ) ;document
            ) ;macro
          ) ;assign
          (assign "unfolded-documentation"
            (macro "x"
              "y"
              (document (render-unfolded-documentation (fold-button (with "color" "#336666" (strong (math (op "<Uparrow>"))))
                                                         (arg "x")
                                                       ) ;fold-button
                          (document (strong (large (arg "x"))))
                          (arg "y")
                        ) ;render-unfolded-documentation
              ) ;document
            ) ;macro
          ) ;assign
          (assign "picture-mixed"
            (macro "x"
              "y"
              (document (concat (action (arg "x") "mouse-unfold" (arg "x")) (hidden (arg "y")))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "source-mixed"
            (macro "x"
              "y"
              (document (render-folded-std (action (resize (active* (with "mode" "math" "" "" "" "" "<blacktriangleleft>"))
                                                     ""
                                                     ""
                                                     (maximum "1r" "1.5fn")
                                                     ""
                                                   ) ;resize
                                             "mouse-fold"
                                             (verbatim (arg "y"))
                                           ) ;action
                          (document (concat (verbatim (arg "y")) (hidden (arg "x"))))
                        ) ;render-folded-std
              ) ;document
            ) ;macro
          ) ;assign
          (assign "folded-grouped"
            (macro "x"
              "y"
              (document (render-folded-grouped (unfold-button " " (arg "x"))
                          (document (arg "x") (hidden (arg "y")))
                        ) ;render-folded-grouped
              ) ;document
            ) ;macro
          ) ;assign
          (assign "unfolded-grouped"
            (macro "x"
              "y"
              (document (render-folded-grouped (fold-button " " (arg "x"))
                          (document (arg "x") (arg "y"))
                        ) ;render-folded-grouped
              ) ;document
            ) ;macro
          ) ;assign
          (assign "folded" (value "folded-std"))
          (assign "unfolded" (value "unfolded-std"))
          (assign "folded-subsession" (value "folded-std"))
          (assign "unfolded-subsession" (value "unfolded-std"))
          ""
          (drd-props "folded-plain" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "folded-std" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "folded-reverse" "arity" "2" "hidden" "0" "accessible" "1")
          (drd-props "folded-env" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "folded-explain" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "folded-documentation" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "picture-mixed" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "folded-grouped" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "folded" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "folded-subsession" "arity" "2" "accessible" "0" "hidden" "1")
          (active* (document (src-comment (document "Tags for toggling between summarized and detailed text.")
                             ) ;src-comment
                   ) ;document
          ) ;active*
          (assign "summarized-plain"
            (macro "x" "y" (document (surround "" (right-flush) (document (arg "x")))))
          ) ;assign
          (assign "detailed-plain"
            (macro "x" "y" (document (surround "" (right-flush) (document (arg "y")))))
          ) ;assign
          (assign "summarized-std"
            (macro "x"
              "y"
              (document (render-folded-std (unfold-button (resize (specific "screen" (active* (with "mode" "math" (op "<circ>"))))
                                                            ""
                                                            ""
                                                            (maximum "1r" "1.5fn")
                                                            ""
                                                          ) ;resize
                                             (arg "x")
                                           ) ;unfold-button
                          (document (arg "x"))
                        ) ;render-folded-std
              ) ;document
            ) ;macro
          ) ;assign
          (assign "detailed-std"
            (macro "x"
              "y"
              (document (render-folded-std (fold-button (resize (specific "screen" (active* (with "mode" "math" "<bullet>")))
                                                          ""
                                                          ""
                                                          (maximum "1r" "1.5fn")
                                                          ""
                                                        ) ;resize
                                             (arg "x")
                                           ) ;fold-button
                          (document (arg "y"))
                        ) ;render-folded-std
              ) ;document
            ) ;macro
          ) ;assign
          (assign "summarized-env"
            (macro "x"
              "y"
              (document (render-folded-env (unfold-button (resize (specific "screen" (active* (with "mode" "math" (op "<circ>"))))
                                                            ""
                                                            ""
                                                            (maximum "1r" "1.5fn")
                                                            ""
                                                          ) ;resize
                                             (arg "x")
                                           ) ;unfold-button
                          (document (arg "x"))
                        ) ;render-folded-env
              ) ;document
            ) ;macro
          ) ;assign
          (assign "detailed-env"
            (macro "x"
              "y"
              (document (render-folded-env (fold-button (resize (specific "screen" (active* (with "mode" "math" "<bullet>")))
                                                          ""
                                                          ""
                                                          (maximum "1r" "1.5fn")
                                                          ""
                                                        ) ;resize
                                             (arg "x")
                                           ) ;fold-button
                          (document (arg "y"))
                        ) ;render-folded-env
              ) ;document
            ) ;macro
          ) ;assign
          (assign "summarized-grouped"
            (macro "x"
              "y"
              (document (render-folded-grouped (unfold-button " " (arg "x")) (document (arg "x")))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "detailed-grouped"
            (macro "x"
              "y"
              (document (render-folded-grouped (fold-button " " (arg "x")) (document (arg "y")))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "summarized-documentation"
            (macro "x"
              "y"
              (document (render-folded-documentation (unfold-button (with "color" "#336666" (strong (large (math (op "<ldots>")))))
                                                       (arg "x")
                                                     ) ;unfold-button
                          (document (strong (large (arg "x"))))
                        ) ;render-folded-documentation
              ) ;document
            ) ;macro
          ) ;assign
          (assign "detailed-documentation"
            (macro "x"
              "y"
              (document (render-folded-documentation (fold-button (with "color" "#336666" (strong (math (op "<Leftarrow>"))))
                                                       (arg "x")
                                                     ) ;fold-button
                          (document (arg "y"))
                        ) ;render-folded-documentation
              ) ;document
            ) ;macro
          ) ;assign
          (assign "summarized-raw" (macro "x" "y" (arg "x")))
          (assign "detailed-raw" (macro "x" "y" (arg "y")))
          (assign "unfold-summarized"
            (macro "x" (action (arg "x") "mouse-unfold" (arg "x")))
          ) ;assign
          (assign "fold-detailed" (macro "x" (action (arg "x") "mouse-fold" (arg "x"))))
          (assign "summarized-tiny"
            (macro "x" "y" (action (arg "x") "mouse-unfold" (arg "x")))
          ) ;assign
          (assign "detailed-tiny" (macro "x" "y" (arg "y")))
          (assign "summarized" (value "summarized-env"))
          (assign "detailed" (value "detailed-env"))
          ""
          (drd-props "summarized-plain" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "summarized-std" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "summarized-env" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "summarized-grouped" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "summarized-tiny" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "summarized" "arity" "2" "accessible" "0" "hidden" "1")
          (drd-props "detailed-plain" "arity" "2" "accessible" "1" "hidden" "0")
          (drd-props "detailed-std" "arity" "2" "accessible" "1" "hidden" "0")
          (drd-props "detailed-env" "arity" "2" "accessible" "1" "hidden" "0")
          (drd-props "detailed-grouped" "arity" "2" "accessible" "1" "hidden" "0")
          (drd-props "detailed-tiny" "arity" "2" "accessible" "1" "hidden" "0")
          (drd-props "detailed" "arity" "2" "accessible" "1" "hidden" "0")
          (active* (document (src-comment (document "Tags for unrolls."))))
          (assign "unroll"
            (xmacro "switch-args"
              (document (surround ""
                          (right-flush)
                          (document (quasi (document (unquote* (quote-arg "switch-args")))))
                        ) ;surround
              ) ;document
            ) ;xmacro
          ) ;assign
          (assign "unroll-phantoms"
            (xmacro "switch-args"
              (document (surround ""
                          (right-flush)
                          (document (hidden-invisible (document (quasi (document (unquote* (quote-arg "switch-args")))))
                                    ) ;hidden-invisible
                          ) ;document
                        ) ;surround
              ) ;document
            ) ;xmacro
          ) ;assign
          (assign "unroll-compressed"
            (xmacro "switch-args"
              (document (surround ""
                          (right-flush)
                          (document (hidden-deleted (document (quasi (document (unquote* (quote-arg "switch-args")))))
                                    ) ;hidden-deleted
                          ) ;document
                        ) ;surround
              ) ;document
            ) ;xmacro
          ) ;assign
          (assign "unroll-greyed"
            (xmacro "switch-args"
              (document (surround ""
                          (right-flush)
                          (document (hidden-greyed (document (quasi (document (unquote* (quote-arg "switch-args")))))
                                    ) ;hidden-greyed
                          ) ;document
                        ) ;surround
              ) ;document
            ) ;xmacro
          ) ;assign
          ""
          (drd-props "unroll" "arity" (tuple "repeat" "1" "1") "accessible" "all")
          (drd-props "unroll-phantoms"
            "arity"
            (tuple "repeat" "1" "1")
            "accessible"
            "all"
          ) ;drd-props
          (drd-props "unroll-compressed"
            "arity"
            (tuple "repeat" "1" "1")
            "accessible"
            "all"
          ) ;drd-props
          (drd-props "unroll-greyed" "arity" (tuple "repeat" "1" "1") "accessible" "all")
          (active* (document (src-comment (document "Tags for switches."))))
          (assign "deprecated-document-block"
            (xmacro "switch-args"
              (document (surround ""
                          (right-flush)
                          (quasi (document (unquote* (quote-arg "switch-args"))))
                        ) ;surround
              ) ;document
            ) ;xmacro
          ) ;assign
          (assign "document-block"
            (xmacro "switch-args"
              (document (surround "" (right-flush) (map-args "identity" "document" "switch-args"))
              ) ;document
            ) ;xmacro
          ) ;assign
          (assign "tiny-block"
            (xmacro "switch-args" (map-args "identity" "concat" "switch-args"))
          ) ;assign
          (assign "slide"
            (macro "body"
              (document (surround ""
                          (if (quasi (tm-last? (unquote (quote-arg "body")) "up")) "" (new-page))
                          (document (arg "body"))
                        ) ;surround
              ) ;document
            ) ;macro
          ) ;assign
          (assign "slides-block"
            (xmacro "switch-args"
              (document (surround ""
                          (right-flush)
                          (quasi (document (unquote* (map "slide" (quote-arg "switch-args")))))
                        ) ;surround
              ) ;document
            ) ;xmacro
          ) ;assign
          (assign "slideshow" (macro "body" (document (arg "body"))))
          ""
          (assign "switch" (value "document-block"))
          (assign "screens" (value "document-block"))
          (assign "tiny-switch" (value "tiny-block"))
          (assign "expanded" (value "document-block"))
          (assign "slides" (value "slides-block"))
          ""
          (drd-props "switch" "arity" (tuple "repeat" "1" "1") "accessible" "all")
          (drd-props "screens"
            "arity"
            (tuple "repeat" "1" "1")
            "accessible"
            "all"
            "border"
            "no"
          ) ;drd-props
          (drd-props "tiny-switch" "arity" (tuple "repeat" "1" "1") "accessible" "all")
          (drd-props "expanded" "arity" (tuple "repeat" "1" "1") "accessible" "all")
          (drd-props "slides" "arity" (tuple "repeat" "1" "1") "accessible" "all")
          (drd-props "slide" "arity" "1" "accessible" "all" "border" "no")
          (drd-props "slideshow" "arity" "1" "accessible" "all" "border" "no")
          ""
          (assign "traversed" (value "identity"))
          (assign "fold-back" (value "identity"))
          (assign "keep-unfolded" (value "identity"))
          (active* (document (src-comment (document "Overlays."))))
          (assign "overlays"
            (macro "current"
              "total"
              "body"
              (with "overlay-nr"
                (arg "current")
                (surround "" (right-flush) (document (arg "body")))
              ) ;with
            ) ;macro
          ) ;assign
          (assign "overlays-phantoms"
            (macro "current"
              "total"
              "body"
              (document (overlays (arg "current")
                          (arg "total")
                          (document (hidden-invisible (document (arg "body"))))
                        ) ;overlays
              ) ;document
            ) ;macro
          ) ;assign
          (assign "overlays-compressed"
            (macro "current"
              "total"
              "body"
              (document (overlays (arg "current")
                          (arg "total")
                          (document (hidden-deleted (document (arg "body"))))
                        ) ;overlays
              ) ;document
            ) ;macro
          ) ;assign
          (assign "overlays-greyed"
            (macro "current"
              "total"
              "body"
              (document (overlays (arg "current")
                          (arg "total")
                          (document (hidden-greyed (document (arg "body"))))
                        ) ;overlays
              ) ;document
            ) ;macro
          ) ;assign
          (assign "overlays-range"
            (macro "start" "end" "body" (with "overlay-nr" (arg "start") (arg "body")))
          ) ;assign
          ""
          (assign "show-always" (macro "here" "true"))
          (assign "show-from"
            (macro "start" (greatereq (value "overlay-nr") (arg "start")))
          ) ;assign
          (assign "show-until" (macro "end" (lesseq (value "overlay-nr") (arg "end"))))
          (assign "show-this" (macro "here" (equal (value "overlay-nr") (arg "here"))))
          (assign "show-other"
            (macro "avoid" (unequal (value "overlay-nr") (arg "avoid")))
          ) ;assign
          ""
          (assign "overlay-cond"
            (macro "cond"
              "body"
              (compound (if (arg "cond") "shown*" "hidden*") (arg "body"))
            ) ;macro
          ) ;assign
          (assign "overlay-from"
            (macro "start"
              "body"
              (overlay-cond (greatereq (value "overlay-nr") (arg "start")) (arg "body"))
            ) ;macro
          ) ;assign
          (assign "overlay-until"
            (macro "end"
              "body"
              (overlay-cond (lesseq (value "overlay-nr") (arg "end")) (arg "body"))
            ) ;macro
          ) ;assign
          (assign "overlay-this"
            (macro "here"
              "body"
              (overlay-cond (equal (value "overlay-nr") (arg "here")) (arg "body"))
            ) ;macro
          ) ;assign
          (assign "overlay-other"
            (macro "avoid"
              "body"
              (overlay-cond (unequal (value "overlay-nr") (arg "avoid")) (arg "body"))
            ) ;macro
          ) ;assign
          ""
          (assign "alternate-cond"
            (macro "cond"
              "b1"
              "b2"
              (style-with "src-compact"
                "none"
                (superpose (compound (if (arg "cond") "hidden*" "shown*") (arg "b1"))
                  (compound (if (arg "cond") "shown*" "hidden*") (arg "b2"))
                ) ;superpose
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "alternate-from"
            (macro "start"
              "b1"
              "b2"
              (alternate-cond (greatereq (value "overlay-nr") (arg "start"))
                (arg "b1")
                (arg "b2")
              ) ;alternate-cond
            ) ;macro
          ) ;assign
          (assign "alternate-until"
            (macro "end"
              "b1"
              "b2"
              (alternate-cond (lesseq (value "overlay-nr") (arg "end")) (arg "b1") (arg "b2"))
            ) ;macro
          ) ;assign
          (assign "alternate-this"
            (macro "here"
              "b1"
              "b2"
              (alternate-cond (equal (value "overlay-nr") (arg "here")) (arg "b1") (arg "b2"))
            ) ;macro
          ) ;assign
          (assign "alternate-other"
            (macro "avoid"
              "b1"
              "b2"
              (alternate-cond (unequal (value "overlay-nr") (arg "avoid"))
                (arg "b1")
                (arg "b2")
              ) ;alternate-cond
            ) ;macro
          ) ;assign
          ""
          (assign "alter-colors"
            (macro "body"
              "hidden-color"
              "shown-color"
              (style-with "src-compact"
                "none"
                (with "hidden*"
                  (quasi (macro "x" (with "color" (unquote (arg "hidden-color")) (arg "x"))))
                  "shown*"
                  (quasi (macro "x" (with "color" (unquote (arg "shown-color")) (arg "x"))))
                  (arg "body")
                ) ;with
              ) ;style-with
            ) ;macro
          ) ;assign
          (drd-props "alter-colors" "arity" "3" "color" "1" "color" "2")
          (active* (document (src-comment (document "Special macros for graphical slideshows.")))
          ) ;active*
          (assign "gpag-length" (macro "1pag"))
          (assign "gpar-length" (macro "1par"))
          (assign "gr-screen"
            (macro "body" (concat (arg "body") (assign "gpag-length" (macro "1pag"))))
          ) ;assign
          (assign "gr-overlays"
            (macro "current"
              "total"
              "body"
              (with "overlay-nr"
                (arg "current")
                (surround "" (right-flush) (document (arg "body")))
              ) ;with
            ) ;macro
          ) ;assign
          (drd-props "gr-screen" "arity" "1" "accessible" "all" "border" "outer")
          (drd-props "gr-overlays" "arity" "3" "accessible" "2" "hidden" "0"
            "hidden" "1" "border" "outer"
          ) ;drd-props
          (active* (document (src-comment (document "Help balloons."))))
          (assign "on-event"
            (xmacro "args"
              (with "old-locus-color"
                (value "locus-color")
                "locus-color"
                "preserve"
                (style-with "src-compact"
                  "none"
                  (locus (id (hard-id (arg "args" "1")))
                    (link (arg "args" "0")
                      (id (hard-id (arg "args" "1")))
                      (map-args "identity" "script" "args" "2")
                    ) ;link
                    (with "locus-color" (value "old-locus-color") (arg "args" "1"))
                  ) ;locus
                ) ;style-with
              ) ;with
            ) ;xmacro
          ) ;assign
          (assign "hover-balloon"
            (macro "x"
              "y"
              "halign"
              "valign"
              (on-event "mouse-over"
                (arg "x")
                "display-balloon"
                (quote-arg "x")
                (arg "y")
                (arg "halign")
                (arg "valign")
                "default"
              ) ;on-event
            ) ;macro
          ) ;assign
          (assign "hover-balloon*"
            (macro "x"
              "y"
              "halign"
              "valign"
              (on-event "mouse-over"
                (arg "x")
                "display-balloon"
                (quote-arg "x")
                (arg "y")
                (arg "halign")
                (arg "valign")
                "mouse"
              ) ;on-event
            ) ;macro
          ) ;assign
          (assign "popup-balloon"
            (macro "x"
              "y"
              "halign"
              "valign"
              (on-event "click"
                (arg "x")
                "display-balloon"
                (quote-arg "x")
                (arg "y")
                (arg "halign")
                (arg "valign")
                "default"
              ) ;on-event
            ) ;macro
          ) ;assign
          (assign "popup-balloon*"
            (macro "x"
              "y"
              "halign"
              "valign"
              (on-event "click"
                (arg "x")
                "display-balloon"
                (quote-arg "x")
                (arg "y")
                (arg "halign")
                (arg "valign")
                "mouse*"
              ) ;on-event
            ) ;macro
          ) ;assign
          (assign "focus-balloon"
            (macro "x"
              "y"
              "halign"
              "valign"
              (on-event "focus"
                (arg "x")
                "display-balloon"
                (quote-arg "x")
                (arg "y")
                (arg "halign")
                (arg "valign")
                "keyboard"
              ) ;on-event
            ) ;macro
          ) ;assign
          (assign "help-balloon-color" "pastel yellow")
          (assign "help-balloon"
            (macro "x"
              "y"
              "halign"
              "valign"
              (hover-balloon* (arg "x")
                (colored-frame (value "help-balloon-color") (arg "y"))
                (arg "halign")
                (arg "valign")
              ) ;hover-balloon*
            ) ;macro
          ) ;assign
          (assign "preview-bg-color" "#edc")
          (assign "preview-balloon"
            (macro "body"
              (tabular (tformat (cwith "1" "1" "1" "1" "cell-hyphen" "t")
                         (cwith "1" "1" "1" "1" "cell-background" (value "preview-bg-color"))
                         (twith "table-width" "40em")
                         (twith "table-hmode" "min")
                         (cwith "1" "1" "1" "1" "cell-lsep" "1spc")
                         (cwith "1" "1" "1" "1" "cell-rsep" "1spc")
                         (cwith "1" "1" "1" "1" "cell-bsep" "1spc")
                         (cwith "1" "1" "1" "1" "cell-tsep" "1spc")
                         (table (row (cell (document (arg "body")))))
                       ) ;tformat
              ) ;tabular
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Parts of documents."))))
          (assign "show-preamble"
            (macro "body"
              (document (with "mode"
                          "src"
                          "preamble"
                          "true"
                          "par-first"
                          "0fn"
                          "par-par-sep"
                          "0.5fn"
                          (arg "body")
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (assign "hide-preamble"
            (macro "body" (document (hidden (filter-style (quote-arg "body")))))
          ) ;assign
          (assign "show-part"
            (macro "id" "active" "inactive" (document (set-part (arg "id") (arg "active"))))
          ) ;assign
          (assign "hide-part"
            (macro "id"
              "active"
              "inactive"
              (document (hidden (set-part (arg "id")
                                  (if (sectional-short-style) (arg "active") (arg "inactive"))
                                ) ;set-part
                        ) ;hidden
              ) ;document
            ) ;macro
          ) ;assign
          (assign "hide-para" (macro "body" (document (hidden (arg "body")))))
          (assign "blank-line" (macro ""))
          (drd-props "show-preamble" "border" "no")
          (drd-props "hide-preamble" "border" "no")
          (drd-props "show-part" "border" "no")
          (drd-props "hide-part" "border" "no" "arity" "3" "hidden" "1")
          (drd-props "hide-para" "border" "no")
          (active* (document (src-comment (document "Different versions of parts of documents.")))
          ) ;active*
          (assign "old-version-color" "#ef4444")
          (assign "old-version-bg-color" "#fef2f2")
          (assign "new-version-color" "#10b981")
          (assign "new-version-bg-color" "#ecfdf5")
          (assign "render-old"
            (macro "old"
              (with "color"
                (value "old-version-color")
                "text-bg-color"
                (value "old-version-bg-color")
                (arg "old")
              ) ;with
            ) ;macro
          ) ;assign
          (assign "render-new"
            (macro "new"
              (with "color"
                (value "new-version-color")
                "text-bg-color"
                (value "new-version-bg-color")
                (arg "new")
              ) ;with
            ) ;macro
          ) ;assign
          (assign "version-old" (macro "old" "new" (render-old (arg "old"))))
          (assign "version-new" (macro "old" "new" (render-new (arg "new"))))
          (assign "version-both-small"
            (macro "old" "new" (concat (render-old (arg "old")) (render-new (arg "new"))))
          ) ;assign
          (assign "version-both-big"
            (macro "old"
              "new"
              (document (render-old (arg "old"))
                (surround "" (right-flush) (render-new (arg "new")))
              ) ;document
            ) ;macro
          ) ;assign
          (assign "version-both"
            (macro "old"
              "new"
              (compound (if (equal (get-label (arg "old")) "document")
                          "version-both-big"
                          "version-both-small"
                        ) ;if
                (arg "old")
                (arg "new")
              ) ;compound
            ) ;macro
          ) ;assign
          (assign "version-suppressed" (macro ""))
        ) ;document
  ) ;body
  (initial (collection (associate "preamble" "true")))
) ;document
