;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(document (TeXmacs "1.99.9")
  (style (tuple "source" "std" "english"))
  (body (document (active* (src-title (document (src-package "std-counter" "1.0")
                                        (src-purpose (document "This package manages counters for sections, theorems, etc.")
                                        ) ;src-purpose
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (active* (document (src-comment (document (concat "The "
                                                      (verbatim "new-counter")
                                                      " primitive is used for the definition of a new counter. Each new counter "
                                                      (verbatim "x")
                                                      " gives rise to several new environment variables:"
                                                    ) ;concat
                                            (concat "  " (verbatim "x-nr") ": the counter itself (an integer).")
                                            (concat "  "
                                              (verbatim "display-x")
                                              ": a macro which will be applied to the counter for displaying it."
                                            ) ;concat
                                            (concat "  "
                                              (verbatim "counter-x")
                                              ": a macro which returns the name of the counter ("
                                              (verbatim "x-nr")
                                              " by default)."
                                            ) ;concat
                                            (concat "  "
                                              (verbatim "the-x")
                                              ": a macro which returns the counter for display."
                                            ) ;concat
                                            (concat "  " (verbatim "reset-x") ": a macro which resets the counter.")
                                            (concat "  " (verbatim "inc-x") ": a macro which increases the counter.")
                                            (concat "  "
                                              (verbatim "next-x")
                                              ": a macro which increases the counter and sets the current label to the counter."
                                            ) ;concat
                                            "The different macros may be changed in order to customize the behaviour of the counter; this feature is used in particular by the grouping primitives defined further below."
                                          ) ;document
                             ) ;src-comment
                   ) ;document
          ) ;active*
          (assign "new-counter"
            (macro "x"
              (quasi (style-with "src-compact"
                       "none"
                       (concat (assign (unquote (merge (arg "x") "-nr")) "0")
                         (assign (unquote (merge "display-" (arg "x"))) (value "identity"))
                         (assign (unquote (merge "counter-" (arg "x")))
                           (macro (style-with "src-compact" "none" (unquote (merge (arg "x") "-nr"))))
                         ) ;assign
                         (assign (unquote (merge "the-" (arg "x")))
                           (macro (style-with "src-compact"
                                    "none"
                                    (compound (unquote (merge "display-" (arg "x")))
                                      (value (compound (unquote (merge "counter-" (arg "x")))))
                                    ) ;compound
                                  ) ;style-with
                           ) ;macro
                         ) ;assign
                         (assign (unquote (merge "reset-" (arg "x")))
                           (macro (style-with "src-compact"
                                    "none"
                                    (assign (compound (unquote (merge "counter-" (arg "x")))) "0")
                                  ) ;style-with
                           ) ;macro
                         ) ;assign
                         (assign (unquote (merge "inc-" (arg "x")))
                           (macro (style-with "src-compact"
                                    "none"
                                    (assign (compound (unquote (merge "counter-" (arg "x"))))
                                      (plus (value (compound (unquote (merge "counter-" (arg "x"))))) "1")
                                    ) ;assign
                                  ) ;style-with
                           ) ;macro
                         ) ;assign
                         (assign (unquote (merge "next-" (arg "x")))
                           (macro (style-with "src-compact"
                                    "none"
                                    (concat (compound (unquote (merge "inc-" (arg "x"))))
                                      (set-binding (compound (unquote (merge "the-" (arg "x")))))
                                    ) ;concat
                                  ) ;style-with
                           ) ;macro
                         ) ;assign
                       ) ;concat
                     ) ;style-with
              ) ;quasi
            ) ;macro
          ) ;assign
          (assign "value-counter"
            (macro "x"
              (style-with "src-compact" "none" (compound (merge "counter-" (arg "x"))))
            ) ;macro
          ) ;assign
          (assign "reset-counter"
            (macro "x"
              (style-with "src-compact" "none" (compound (merge "reset-" (arg "x"))))
            ) ;macro
          ) ;assign
          (assign "inc-counter"
            (macro "x"
              (style-with "src-compact" "none" (compound (merge "inc-" (arg "x"))))
            ) ;macro
          ) ;assign
          (assign "next-counter"
            (macro "x"
              (style-with "src-compact" "none" (compound (merge "next-" (arg "x"))))
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document (concat "Counters for similar environments (like "
                                                      (verbatim "theorem")
                                                      ", "
                                                      (verbatim "proposition")
                                                      ", etc.) can be grouped together from a logical point of view into ‘‘counter groups''. When using this feature, the different environments can either share a common counter ("
                                                      (verbatim "group-common-counter")
                                                      "; ‘‘american style'') or continue to use their own counters ("
                                                      (verbatim "group-individual-counters")
                                                      "; ‘‘european style''). When calling a macro like "
                                                      (verbatim "reset-g")
                                                      " for a counter group "
                                                      (verbatim "g")
                                                      ", all counters in the group are set to zero. Similarly, sectional prefixes can be shared by the environments in a group."
                                                    ) ;concat
                                          ) ;document
                             ) ;src-comment
                   ) ;document
          ) ;active*
          (assign "new-counter-group"
            (macro "g"
              (style-with "src-compact"
                "none"
                (concat (assign (merge (arg "g") "-group") (tuple))
                  (new-counter (arg "g"))
                  (group-individual-counters (arg "g"))
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "add-to-counter-group"
            (macro "x"
              "g"
              (quasi (style-with "src-compact"
                       "none"
                       (concat (assign (unquote (merge (arg "g") "-group"))
                                 (merge (value (merge (arg "g") "-group")) (tuple (arg "x")))
                               ) ;assign
                         (new-counter (arg "x"))
                         (assign (unquote (merge "ind-display-" (arg "x")))
                           (value (unquote (merge "display-" (arg "x"))))
                         ) ;assign
                         (assign (unquote (merge "ind-counter-" (arg "x")))
                           (value (unquote (merge "counter-" (arg "x"))))
                         ) ;assign
                         (assign (unquote (merge "display-" (arg "x")))
                           (macro "nr"
                             (style-with "src-compact"
                               "none"
                               (compound (unquote (merge "display-in-" (arg "g")))
                                 (unquote (arg "x"))
                                 (arg "nr")
                               ) ;compound
                             ) ;style-with
                           ) ;macro
                         ) ;assign
                         (assign (unquote (merge "counter-" (arg "x")))
                           (macro (style-with "src-compact"
                                    "none"
                                    (compound (unquote (merge "counter-in-" (arg "g"))) (unquote (arg "x")))
                                  ) ;style-with
                           ) ;macro
                         ) ;assign
                       ) ;concat
                     ) ;style-with
              ) ;quasi
            ) ;macro
          ) ;assign
          (assign "group-common-counter"
            (macro "g"
              (quasi (style-with "src-compact"
                       "none"
                       (concat (assign (unquote (merge "display-in-" (arg "g")))
                                 (macro "x"
                                   "nr"
                                   (style-with "src-compact"
                                     "none"
                                     (compound (unquote (merge "display-" (arg "g"))) (arg "nr"))
                                   ) ;style-with
                                 ) ;macro
                               ) ;assign
                         (assign (unquote (merge "counter-in-" (arg "g")))
                           (macro "x"
                             (style-with "src-compact"
                               "none"
                               (compound (unquote (merge "counter-" (arg "g"))))
                             ) ;style-with
                           ) ;macro
                         ) ;assign
                         (assign (unquote (merge "reset-" (arg "g")))
                           (macro (style-with "src-compact"
                                    "none"
                                    (assign (compound (unquote (merge "counter-" (arg "g")))) "0")
                                  ) ;style-with
                           ) ;macro
                         ) ;assign
                       ) ;concat
                     ) ;style-with
              ) ;quasi
            ) ;macro
          ) ;assign
          (assign "group-individual-counters"
            (macro "g"
              (quasi (style-with "src-compact"
                       "none"
                       (concat (assign (unquote (merge "display-in-" (arg "g")))
                                 (macro "x"
                                   "nr"
                                   (style-with "src-compact"
                                     "none"
                                     (compound (unquote (merge "display-" (arg "g")))
                                       (style-with "src-compact"
                                         "none"
                                         (compound (merge "ind-display-" (arg "x")) (arg "nr"))
                                       ) ;style-with
                                     ) ;compound
                                   ) ;style-with
                                 ) ;macro
                               ) ;assign
                         (assign (unquote (merge "counter-in-" (arg "g")))
                           (macro "x"
                             (style-with "src-compact" "none" (compound (merge "ind-counter-" (arg "x"))))
                           ) ;macro
                         ) ;assign
                         (assign (unquote (merge "reset-" (arg "g")))
                           (macro (style-with "src-compact"
                                    "none"
                                    (concat (assign (compound (unquote (merge "counter-" (arg "x")))) "0")
                                      (for-each "reset-counter" (value (unquote (merge (arg "g") "-group"))))
                                    ) ;concat
                                  ) ;style-with
                           ) ;macro
                         ) ;assign
                       ) ;concat
                     ) ;style-with
              ) ;quasi
            ) ;macro
          ) ;assign
          (assign "individual-counter"
            (macro "x"
              (style-with "src-compact"
                "none"
                (concat (quasi (assign (unquote (merge "display-" (arg "x")))
                                 (value (unquote (merge "ind-display-" (arg "x"))))
                               ) ;assign
                        ) ;quasi
                  (quasi (assign (unquote (merge "counter-" (arg "x")))
                           (value (unquote (merge "ind-counter-" (arg "x"))))
                         ) ;assign
                  ) ;quasi
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          ""
        ) ;document
  ) ;body
  (initial (collection))
) ;document
