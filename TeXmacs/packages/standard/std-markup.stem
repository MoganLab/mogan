              ) ;add-font-effect
            ) ;macro
          ) ;assign
          (assign "gnawed"
            (macro "body"
              (add-font-effect "gnawed"
                (merge (value "gnawed-strength") ";" (value "gnawed-frequency"))
                (arg "body")
              ) ;add-font-effect
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Artistic font effects."))))
          (assign "blurred-radius" "0.6pt")
          (assign "shadow-font-color" "#222")
          (assign "sunny-font-color" "#ddd")
          ""
          (assign "blurred"
