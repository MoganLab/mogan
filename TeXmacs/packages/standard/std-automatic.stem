;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(document (TeXmacs "2.1.2")
  (style (tuple "source" "std"))
  (body (document (active* (src-title (document (src-package "std-automatic" "1.0")
                                        (src-purpose (document "This package contains macros for the automatic generation of content (citations, tables of contents, indexes and glossaries) and the rendering of such content."
                                                     ) ;document
                                        ) ;src-purpose
                                      ) ;document
                           ) ;src-title
                  ) ;active*
          (active* (document (src-comment (document "Automatically generated labels."))))
          (new-counter "auto")
          (assign "current-part" "")
          (assign "set-part"
            (macro "Id"
              "body"
              (with "current-part"
                (merge (value "current-part") "." (arg "Id"))
                "auto-nr"
                "0"
                (arg "body")
              ) ;with
            ) ;macro
          ) ;assign
          (assign "the-auto"
            (macro (merge "auto" (value "current-part") "-" (value "auto-nr")))
          ) ;assign
          (assign "auto-label" (macro (concat (inc-auto) (label (the-auto)))))
          (active* (document (src-comment (document "Citations."))))
          (assign "bib-prefix" "bib")
          (assign "with-bib"
            (macro "bib" "body" (with "bib-prefix" (arg "bib") (arg "body")))
          ) ;assign
          (assign "render-cite" (macro "body" (concat "[" (arg "body") "]")))
          (assign "render-cite-detail"
            (macro "body" "detail" (render-cite (concat (arg "body") ", " (arg "detail"))))
          ) ;assign
          (assign "cite-sep" (macro ", "))
          (assign "cite-arg"
            (macro "key"
              (concat (write (value "bib-prefix") (arg "key"))
                (reference (merge (value "bib-prefix") "-" (arg "key")))
              ) ;concat
            ) ;macro
          ) ;assign
          (assign "cite-arg-extra"
            (macro "key" (concat (cite-sep) (cite-arg (arg "key"))))
          ) ;assign
          (assign "cite"
            (xmacro "keys"
              (render-cite (concat (cite-arg (arg "keys" "0"))
                             (map-args "cite-arg-extra" "concat" "keys" "1")
                           ) ;concat
              ) ;render-cite
            ) ;xmacro
          ) ;assign
          (assign "cite-detail"
            (macro "key"
              "details"
              (render-cite-detail (cite-arg (arg "key")) (arg "details"))
            ) ;macro
          ) ;assign
          (assign "cite-raw"
            (xmacro "keys"
              (concat (cite-arg (arg "keys" "0"))
                (map-args "cite-arg-extra" "concat" "keys" "1")
              ) ;concat
            ) ;xmacro
          ) ;assign
          (assign "nocite-arg" (macro "key" (write (value "bib-prefix") (arg "key"))))
          (assign "nocite"
            (xmacro "keys"
              (style-with "src-compact"
                "none"
                (concat (flag (localize "bibliography") "dark green" "keys")
                  (map-args "nocite-arg" "concat" "keys")
                ) ;concat
              ) ;style-with
            ) ;xmacro
          ) ;assign
          (drd-props "cite"
            "arity"
            (tuple "repeat" "1" "1")
            "accessible"
            "none"
            "identifier"
            "all"
          ) ;drd-props
          (drd-props "nocite"
            "arity"
            (tuple "repeat" "1" "1")
            "accessible"
            "none"
            "identifier"
            "all"
          ) ;drd-props
          (drd-props "cite-detail" "arity" "2" "unaccessible" "0" "identifier" "0")
          (active* (document (src-comment (document "Bibliographies."))))
          (assign "bibitem-width" "3em")
          (assign "transform-bibitem" (macro "body" (concat "[" (arg "body") "]  ")))
          (assign "render-bibitem"
            (macro "text"
              (style-with "src-compact"
                "none"
                (concat (with "par-first" (minus "1tmpt" (value "bibitem-width")) (yes-indent))
                  (resize (arg "text") "" "" (maximum "1r" (value "bibitem-width")) "")
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "tmhtml-render-bibitem" (macro "text" (concat (arg "text") " ")))
          (assign "tmhtml-render-bibitem" (macro "text" (item* (arg "text"))))
          (assign "bibitem"
            (macro "text"
              (style-with "src-compact"
                "none"
                (concat (bibitem* (arg "text"))
                  (label (merge (value "bib-prefix") "-" (arg "text")))
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "bibitem-with-key"
            (macro "text"
              "key"
              (style-with "src-compact"
                "none"
                (concat (bibitem* (arg "text"))
                  (label (merge (value "bib-prefix") "-" (arg "key")))
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "bibitem*"
            (macro "text"
              (style-with "src-compact"
                "none"
                (concat (render-bibitem (transform-bibitem (arg "text")))
                  (set-binding (arg "text"))
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "protect" "")
          (assign "newblock" "")
          (assign "citeauthoryear"
            (macro "author" "year" (concat (arg "author") " " (arg "year")))
          ) ;assign
          (assign "bibitem-hsep" (macro (value "bibitem-width")))
          (assign "bib-list"
            (macro "largest"
              "body"
              (document (with "bibitem-width"
                          (minimum (box-info (concat (transform-bibitem (arg "largest")) ".") "w.") "3em")
                          "item-hsep"
                          (value "bibitem-hsep")
                          "bibitem-nr"
                          "0"
                          "par-flexibility"
                          "2.0"
                          (document (description (document (arg "body"))))
                        ) ;with
              ) ;document
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Tables of contents."))))
          (assign "toc-prefix" "toc")
          (assign "with-toc"
            (macro "toc" "body" (with "toc-prefix" (arg "toc") (arg "body")))
          ) ;assign
          (assign "toc-next" "")
          (assign "toc-override"
            (macro "what"
              (style-with "src-compact"
                "none"
                (concat (flag (localize "override toc entry") "dark green" "what")
                  (assign "toc-next" (arg "what"))
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "toc-entry"
            (macro "type"
              "what"
              (quasi (style-with "src-compact"
                       "none"
                       ""
                       ""
                       (concat (flag (localize "table of contents") "dark green" "what")
                         (auto-label)
                         (write (value "toc-prefix")
                           (compound (unquote (arg "type")) (arg "what") (pageref (the-auto)))
                         ) ;write
                         (style-with "src-compact"
                           "none"
                           (if (equal (value "toc-next") "")
                             (toc-notify (arg "type") (arg "what"))
                             (concat (toc-notify (arg "type") (value "toc-next")) (assign "toc-next" ""))
                           ) ;if
                         ) ;style-with
                       ) ;concat
                     ) ;style-with
              ) ;quasi
            ) ;macro
          ) ;assign
          (assign "toc-main-1" (macro "what" (toc-entry "toc-strong-1" (arg "what"))))
          (assign "toc-main-2" (macro "what" (toc-entry "toc-strong-2" (arg "what"))))
          (assign "toc-normal-1" (macro "what" (toc-entry "toc-1" (arg "what"))))
          (assign "toc-normal-2" (macro "what" (toc-entry "toc-2" (arg "what"))))
          (assign "toc-normal-3" (macro "what" (toc-entry "toc-3" (arg "what"))))
          (assign "toc-small-1" (macro "what" (toc-entry "toc-4" (arg "what"))))
          (assign "toc-small-2" (macro "what" (toc-entry "toc-5" (arg "what"))))
          ""
          (assign "toc-dots"
            (macro (datoms (macro "x"
                             (repeat (arg "x")
                               (with "font-series"
                                 "medium"
                                 (with "font-size" "1" (concat (space "0.05fn") "." (space "0.05fn")))
                               ) ;with
                             ) ;repeat
                           ) ;macro
                     (htab "5mm")
                   ) ;datoms
            ) ;macro
          ) ;assign
          (assign "toc-strong-1"
            (macro "left"
              "right"
              (concat (vspace* "2fn")
                (with "font-series"
                  "bold"
                  "math-font-series"
                  "bold"
                  "font-size"
                  "1.19"
                  (arg "left")
                ) ;with
                (toc-dots)
                (no-break)
                (arg "right")
                (vspace "1fn")
              ) ;concat
            ) ;macro
          ) ;assign
          (assign "toc-strong-2"
            (macro "left"
              "right"
              (concat (vspace* "1fn")
                (with "font-series" "bold" "math-font-series" "bold" (arg "left"))
                (toc-dots)
                (no-break)
                (arg "right")
                (vspace "0.5fn")
              ) ;concat
            ) ;macro
          ) ;assign
          (assign "toc-1"
            (macro "left" "right" (concat (arg "left") (toc-dots) (no-break) (arg "right")))
          ) ;assign
          (assign "toc-2"
            (macro "left"
              "right"
              (with "par-left"
                "1tab"
                (concat (arg "left") (toc-dots) (no-break) (arg "right"))
              ) ;with
            ) ;macro
          ) ;assign
          (assign "toc-3"
            (macro "left"
              "right"
              (with "par-left"
                "2tab"
                (concat (arg "left") (toc-dots) (no-break) (arg "right"))
              ) ;with
            ) ;macro
          ) ;assign
          (assign "toc-4"
            (macro "left"
              "right"
              (with "par-left"
                "3tab"
                (concat (arg "left") (toc-dots) (no-break) (arg "right"))
              ) ;with
            ) ;macro
          ) ;assign
          (assign "toc-5"
            (macro "left"
              "right"
              (with "par-left"
                "4tab"
                (concat (arg "left") (toc-dots) (no-break) (arg "right"))
              ) ;with
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Indexes."))))
          (assign "index-enabled" "true")
          (assign "index-prefix" "idx")
          (assign "with-index"
            (macro "idx" "body" (with "index-prefix" (arg "idx") (arg "body")))
          ) ;assign
          (assign "index-line"
            (macro "key"
              "entry"
              (style-with "src-compact"
                "none"
                (concat (flag (localize "index") "dark green" "key")
                  (write (value "index-prefix") (tuple (arg "key") "" (arg "entry")))
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "index-write"
            (macro "entry"
              (style-with "src-compact"
                "none"
                (if (value "index-enabled")
                  (concat (auto-label)
                    (write (value "index-prefix") (tuple (arg "entry") (pageref (the-auto))))
                  ) ;concat
                ) ;if
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "index"
            (macro "key"
              (style-with "src-compact"
                "none"
                (concat (assign "the-label" (arg "key"))
                  (flag (localize "index") "dark green" "key")
                  (index-write (tuple (arg "key")))
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "subindex"
            (macro "key"
              "secondary"
              (style-with "src-compact"
                "none"
                (concat (assign "the-label" (arg "key"))
                  (flag (localize "index") "dark green" "key")
                  (index-write (tuple (arg "key") (arg "secondary")))
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "subsubindex"
            (macro "key"
              "secondary"
              "tertiary"
              (style-with "src-compact"
                "none"
                (concat (assign "the-label" (arg "key"))
                  (flag (localize "index") "dark green" "key")
                  (index-write (tuple (arg "key") (arg "secondary") (arg "tertiary")))
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "subsubsubindex"
            (macro "key"
              "secondary"
              "tertiary"
              "quaternary"
              (style-with "src-compact"
                "none"
                (concat (assign "the-label" (arg "key"))
                  (flag (localize "index") "dark green" "key")
                  (index-write (tuple (arg "key") (arg "secondary") (arg "tertiary") (arg "quaternary"))
                  ) ;index-write
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "index-complex"
            (macro "key"
              "how"
              "range"
              "entry"
              (style-with "src-compact"
                "none"
                (concat (assign "the-label" (arg "key"))
                  (flag (localize "index") "dark green" "key")
                  (auto-label)
                  (write (value "index-prefix")
                    (tuple (arg "key") (arg "how") (arg "range") (arg "entry") (pageref (the-auto)))
                  ) ;write
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          ""
          (assign "index-dots"
            (macro (concat " "
                     (datoms (macro "x"
                               (repeat (arg "x")
                                 (with "font-series"
                                   "medium"
                                   (with "font-size" "1" (concat (space "0.2fn") "." (space "0.2fn")))
                                 ) ;with
                               ) ;repeat
                             ) ;macro
                       (htab "5mm")
                     ) ;datoms
                     " "
                   ) ;concat
            ) ;macro
          ) ;assign
          (assign "index-1"
            (macro "left"
              "right"
              (with "par-left" "0tab" (concat (arg "left") (index-dots) (arg "right")))
            ) ;macro
          ) ;assign
          (assign "index-1*"
            (macro "left" (with "par-left" "0tab" (concat (arg "left") (no-page-break))))
          ) ;assign
          (assign "index-2"
            (macro "left"
              "right"
              (with "par-left" "1tab" (concat (arg "left") (index-dots) (arg "right")))
            ) ;macro
          ) ;assign
          (assign "index-2*"
            (macro "left" (with "par-left" "1tab" (concat (arg "left") (no-page-break))))
          ) ;assign
          (assign "index-3"
            (macro "left"
              "right"
              (with "par-left" "2tab" (concat (arg "left") (index-dots) (arg "right")))
            ) ;macro
          ) ;assign
          (assign "index-3*"
            (macro "left" (with "par-left" "2tab" (concat (arg "left") (no-page-break))))
          ) ;assign
          (assign "index-4"
            (macro "left"
              "right"
              (with "par-left" "3tab" (concat (arg "left") (index-dots) (arg "right")))
            ) ;macro
          ) ;assign
          (assign "index-4*"
            (macro "left" (with "par-left" "3tab" (concat (arg "left") (no-page-break))))
          ) ;assign
          (assign "index-5"
            (macro "left"
              "right"
              (with "par-left" "4tab" (concat (arg "left") (index-dots) (arg "right")))
            ) ;macro
          ) ;assign
          (assign "index-5*"
            (macro "left" (with "par-left" "4tab" (concat (arg "left") (no-page-break))))
          ) ;assign
          ""
          (assign "index-break-style" "recall")
          (assign "index+1" (macro "l1" "right" (index-1 (arg "l1") (arg "right"))))
          (assign "index+1*" (macro "l1" (index-1* (arg "l1"))))
          (assign "index+2"
            (macro "l1"
              "l2"
              "right"
              (index-2 (concat (if-page-break "t" (document (index-1* (arg "l1")))) (arg "l2"))
                (arg "right")
              ) ;index-2
            ) ;macro
          ) ;assign
          (assign "index+2*"
            (macro "l1"
              "l2"
              (index-2* (concat (if-page-break "t" (document (index-1* (arg "l1")))) (arg "l2"))
              ) ;index-2*
            ) ;macro
          ) ;assign
          (assign "index+3"
            (macro "l1"
              "l2"
              "l3"
              "right"
              (index-3 (concat (if-page-break "t" (document (index-1* (arg "l1")) (index-2* (arg "l2"))))
                         (arg "l3")
                       ) ;concat
                (arg "right")
              ) ;index-3
            ) ;macro
          ) ;assign
          (assign "index+3*"
            (macro "l1"
              "l2"
              "l3"
              (index-3* (concat (if-page-break "t" (document (index-1* (arg "l1")) (index-2* (arg "l2"))))
                          (arg "l3")
                        ) ;concat
              ) ;index-3*
            ) ;macro
          ) ;assign
          (assign "index+4"
            (macro "l1"
              "l2"
              "l3"
              "l4"
              "right"
              (index-4 (concat (if-page-break "t"
                                 (document (index-1* (arg "l1")) (index-2* (arg "l2")) (index-3* (arg "l3")))
                               ) ;if-page-break
                         (arg "l4")
                       ) ;concat
                (arg "right")
              ) ;index-4
            ) ;macro
          ) ;assign
          (assign "index+4*"
            (macro "l1"
              "l2"
              "l3"
              "l4"
              (index-4* (concat (if-page-break "t"
                                  (document (index-1* (arg "l1")) (index-2* (arg "l2")) (index-3* (arg "l3")))
                                ) ;if-page-break
                          (arg "l4")
                        ) ;concat
              ) ;index-4*
            ) ;macro
          ) ;assign
          (assign "index+5"
            (macro "l1"
              "l2"
              "l3"
              "l4"
              "l5"
              "right"
              (index-5 (concat (if-page-break "t"
                                 (document (index-1* (arg "l1"))
                                   (index-2* (arg "l2"))
                                   (index-3* (arg "l3"))
                                   (index-4* (arg "l4"))
                                 ) ;document
                               ) ;if-page-break
                         (arg "l5")
                       ) ;concat
                (arg "right")
              ) ;index-5
            ) ;macro
          ) ;assign
          (assign "index+5*"
            (macro "l1"
              "l2"
              "l3"
              "l4"
              "l5"
              (index-5* (concat (if-page-break "t"
                                  (document (index-1* (arg "l1"))
                                    (index-2* (arg "l2"))
                                    (index-3* (arg "l3"))
                                    (index-4* (arg "l4"))
                                  ) ;document
                                ) ;if-page-break
                          (arg "l5")
                        ) ;concat
              ) ;index-5*
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Glossaries."))))
          (assign "glossary-prefix" "gly")
          (assign "with-glossary"
            (macro "gly" "body" (with "glossary-prefix" (arg "gly") (arg "body")))
          ) ;assign
          (assign "glossary-line"
            (macro "entry"
              (style-with "src-compact"
                "none"
                (concat (assign "the-label" (arg "entry"))
                  (flag (localize "glossary") "dark green" "entry")
                  (write (value "glossary-prefix") (tuple (arg "entry")))
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "glossary"
            (macro "entry"
              (style-with "src-compact"
                "none"
                (concat (assign "the-label" (arg "entry"))
                  (flag (localize "glossary") "dark green" "entry")
                  (auto-label)
                  (write (value "glossary-prefix")
                    (tuple "normal" (arg "entry") (pageref (the-auto)))
                  ) ;write
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "glossary-explain"
            (macro "entry"
              "explain"
              (style-with "src-compact"
                "none"
                (concat (assign "the-label" (arg "entry"))
                  (flag (localize "glossary") "dark green" "entry")
                  (auto-label)
                  (write (value "glossary-prefix")
                    (tuple "normal" (arg "entry") (arg "explain") (pageref (the-auto)))
                  ) ;write
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "glossary-dup"
            (macro "entry"
              (style-with "src-compact"
                "none"
                (concat (assign "the-label" (arg "entry"))
                  (flag (localize "glossary") "dark green" "entry")
                  (auto-label)
                  (write (value "glossary-prefix")
                    (tuple "dup" (arg "entry") (pageref (the-auto)))
                  ) ;write
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          ""
          (assign "glossary-dots"
            (macro (concat " "
                     (datoms (macro "x"
                               (repeat (arg "x")
                                 (with "font-series"
                                   "medium"
                                   (with "font-size" "1" (concat (space "0.2fn") "." (space "0.2fn")))
                                 ) ;with
                               ) ;repeat
                             ) ;macro
                       (htab "5mm")
                     ) ;datoms
                     " "
                   ) ;concat
            ) ;macro
          ) ;assign
          (assign "glossary-1"
            (macro "left"
              "right"
              (concat (arg "left") (glossary-dots) (no-break) (arg "right"))
            ) ;macro
          ) ;assign
          (assign "glossary-2"
            (macro "entry"
              "explain"
              "right"
              (margin-first-other "0fn"
                "10fn"
                (style-with "src-compact"
                  "none"
                  (concat (resize (concat (arg "entry") " ") "" "" (maximum "1r" "10fn") "")
                    (arg "explain")
                    (glossary-dots)
                    (no-break)
                    (arg "right")
                  ) ;concat
                ) ;style-with
              ) ;margin-first-other
            ) ;macro
          ) ;assign
          (active* (document (src-comment (document "Shared documents."))))
          (assign "part-info"
            (macro "name"
              (style-with "src-compact"
                "none"
                (concat (label (merge "part:" (arg "name")))
                  (write "parts"
                    (tuple (arg "name")
                      "chapter-nr"
                      (value "chapter-nr")
                      "section-nr"
                      (value "section-nr")
                      "subsection-nr"
                      (value "subsection-nr")
                    ) ;tuple
                  ) ;write
                ) ;concat
              ) ;style-with
            ) ;macro
          ) ;assign
          (assign "shared"
            (macro "unique-id"
              "mirror-id"
              "body"
              (with "old-color"
                (value "locus-color")
                "locus-color"
                "preserve"
                (locus (id (arg "mirror-id"))
                  (observer (arg "unique-id") "mirror-notify")
                  (surround (hidden (concat (part-info (arg "unique-id"))
                                      (extern "mirror-initialize" (quote-arg "xbody"))
                                    ) ;concat
                            ) ;hidden
                    (right-flush)
                    (with "locus-color" (value "old-color") (arg "body"))
                  ) ;surround
                ) ;locus
              ) ;with
            ) ;macro
          ) ;assign
          (assign "include"
            (macro "name"
              (surround (part-info (arg "name")) "" (document (include* (arg "name"))))
            ) ;macro
          ) ;assign
        ) ;document
  ) ;body
  (initial (collection (associate "preamble" "true")))
) ;document
