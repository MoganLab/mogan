    <|input>
      def test_text_and_shapes():

      \ \ \ \ """测试文字和图形绘制"""

      \ \ \ \ 

      \ \ \ \ # 1. 文字图像

      \ \ \ \ text_img = Image.new('RGB', (400, 150), color='white')

      \ \ \ \ draw = ImageDraw.Draw(text_img)

      \ \ \ \ 

      \ \ \ \ try:

      \ \ \ \ \ \ \ \ font = ImageFont.truetype("arial.ttf", 24)

      \ \ \ \ except:

      \ \ \ \ \ \ \ \ font = ImageFont.load_default()

      \ \ \ \ 

      \ \ \ \ draw.text((20, 20), "Hello Pillow!", fill='black', font=font)

      \ \ \ \ draw.text((20, 60), "测试中文文字", fill='blue', font=font)

      \ \ \ \ 

      \ \ \ \ # 2. 几何图形

      \ \ \ \ shapes_img = Image.new('RGB', (300, 300), color='lightgray')

      \ \ \ \ draw = ImageDraw.Draw(shapes_img)

      \ \ \ \ 

      \ \ \ \ # 绘制矩形

      \ \ \ \ draw.rectangle([50, 50, 150, 150], fill='red', outline='black')

      \ \ \ \ # 绘制圆形

      \ \ \ \ draw.ellipse([180, 50, 280, 150], fill='green', outline='black')

      \ \ \ \ # 绘制线条

      \ \ \ \ draw.line([(50, 200), (250, 200)], fill='blue', width=3)

      \ \ \ \ 

      \ \ \ \ return [text_img, shapes_img]

      \;

      # 运行测试

      drawing_images = test_text_and_shapes()
    </input>

