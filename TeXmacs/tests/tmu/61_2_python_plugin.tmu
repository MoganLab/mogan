      def test_image_modes():

      \ \ \ \ """测试不同图像模式"""

      \ \ \ \ 

      \ \ \ \ images = []

      \ \ \ \ 

      \ \ \ \ # RGB 模式

      \ \ \ \ rgb_img = Image.new('RGB', (150, 150), color=(255, 128, 0))

      \ \ \ \ images.append(rgb_img)

      \ \ \ \ 

      \ \ \ \ # RGBA 模式 (带透明度)

      \ \ \ \ rgba_img = Image.new('RGBA', (150, 150), color=(255, 0, 0, 128))

      \ \ \ \ images.append(rgba_img)

      \ \ \ \ 

      \ \ \ \ # 灰度模式

      \ \ \ \ grayscale_img = Image.new('L', (150, 150), color=128)

      \ \ \ \ images.append(grayscale_img)

      \ \ \ \ 

      \ \ \ \ # 二值图像

      \ \ \ \ binary_img = Image.new('1', (150, 150))

      \ \ \ \ # 添加一些图案

      \ \ \ \ for x in range(150):

      \ \ \ \ \ \ \ \ for y in range(150):

      \ \ \ \ \ \ \ \ \ \ \ \ binary_img.putpixel((x, y), (x + y) % 20 \<gtr\> 10)

      \ \ \ \ images.append(binary_img)

      \ \ \ \ 

      \ \ \ \ return images

      \;

      # 运行测试

      mode_images = test_image_modes()
    </input>

