      from PIL import ImageFilter, ImageOps

      \;

      def test_image_filters():

      \ \ \ \ """测试图像滤镜效果"""

      \ \ \ \ 

      \ \ \ \ # 创建基础图像

      \ \ \ \ base_img = Image.new('RGB', (200, 200))

      \ \ \ \ # 添加一些图案

      \ \ \ \ for i in range(200):

      \ \ \ \ \ \ \ \ for j in range(200):

      \ \ \ \ \ \ \ \ \ \ \ \ base_img.putpixel((i, j), ((i+j)%255, i%255, j%255))

      \ \ \ \ 

      \ \ \ \ # 应用不同滤镜

      \ \ \ \ blurred = base_img.filter(ImageFilter.GaussianBlur(3))

      \ \ \ \ # 创建高斯模糊图像

      \ \ \ \ 

      \ \ \ \ contour = base_img.filter(ImageFilter.CONTOUR)

      \ \ \ \ # 创建轮廓图像

      \ \ \ \ 

      \ \ \ \ edges = base_img.filter(ImageFilter.FIND_EDGES)

      \ \ \ \ # 创建边缘检测图像

      \ \ \ \ 

      \ \ \ \ # 颜色操作

      \ \ \ \ inverted = ImageOps.invert(base_img)

      \ \ \ \ # 创建反色图像

      \ \ \ \ 

      \ \ \ \ return [base_img, blurred, contour, edges, inverted]

      \;

      # 运行测试

      filter_images = test_image_filters()
    </input>

