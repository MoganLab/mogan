      # List 包含各种SymPy对象

      sympy_list = [

      \ \ \ \ x**2, \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ # 幂运算

      \ \ \ \ sp.sin(x) + sp.cos(y), \ \ \ \ \ \ \ \ # 三角函数组合

      \ \ \ \ sp.diff(x**3, x), \ \ \ \ \ \ \ \ \ \ \ \ \ # 导数: 3*x**2

      \ \ \ \ sp.Integral(sp.exp(-x), x), \ \ \ # 积分

      \ \ \ \ sp.Eq(x + y, 10), \ \ \ \ \ \ \ \ \ \ \ \ \ # 方程

      \ \ \ \ sp.Matrix([[1, x], [y, 2]]), \ \ # 符号矩阵

      \ \ \ \ sp.Rational(3, 4), \ \ \ \ \ \ \ \ \ \ \ \ # 有理数

      \ \ \ \ sp.series(sp.log(1+x), x, 0, 4) # 级数展开

      ]

      \;
    </input>

