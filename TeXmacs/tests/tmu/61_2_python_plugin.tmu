      from PIL import Image, ImageDraw, ImageFont

      import random

      \;

      def test_basic_images():

      \ \ \ \ """测试基础图像创建"""

      \ \ \ \ 

      \ \ \ \ # 1. 纯色图像

      \ \ \ \ red_image = Image.new('RGB', (300, 200), color='red')

      \ \ \ \ 

      \ \ \ \ # 2. 渐变图像

      \ \ \ \ gradient = Image.new('RGB', (300, 200))

      \ \ \ \ for x in range(300):

      \ \ \ \ \ \ \ \ for y in range(200):

      \ \ \ \ \ \ \ \ \ \ \ \ gradient.putpixel((x, y), (x, y, (x+y)//2))

      \ \ \ \ 

      \ \ \ \ # 3. 随机噪声图像

      \ \ \ \ noise = Image.new('RGB', (300, 200))

      \ \ \ \ pixels = [(random.randint(0,255), random.randint(0,255), random.randint(0,255))\ 

      \ \ \ \ \ \ \ \ \ \ \ \ \ \ for _ in range(300*200)]

      \ \ \ \ noise.putdata(pixels)

      \ \ \ \ 

      \ \ \ \ return [red_image, gradient, noise]

      \;

      # 运行测试

      basic_images = test_basic_images()
    </input>

    <\unfolded-io>
