<style|<tuple|tmudoc|chinese|python>>

<\body>
  <tmdoc-title|Python 工作流验证用例>

  本文件用于验证 Mogan STEM Python 插件在 Conda 环境下的核心功能。请切换到包含 pandas, matplotlib, sympy 的 conda 环境运行。

  <section|1. 验证 Pandas 表格渲染>

  <\session|python|default>
    <\unfolded-io>
      \<gtr\>\<gtr\>\<gtr\>\ 
    <|unfolded-io>
      import pandas as pd
      df = pd.DataFrame({'Test': [1, 2], 'Value': [10.5, 20.3]})
      df
    <|unfolded-io>
      <tabular|<tformat|<cwith|1|1|1|-1|cell-bborder|1ln>|<table|<row|<cell|>|<cell|'Test'>|<cell|'Value'>>|<row|<cell|0>|<cell|1>|<cell|10.5>>|<row|<cell|1>|<cell|2>|<cell|20.3>>>>>
    </unfolded-io>
  </session>

  <section|2. 验证 Matplotlib 矢量图渲染>

  <\session|python|default>
    <\unfolded-io>
      \<gtr\>\<gtr\>\<gtr\>\ 
    <|unfolded-io>
      import matplotlib.pyplot as plt
      plt.plot([1, 2, 3], [1, 4, 9])
      plt.gcf()
    <|unfolded-io>
      (预期输出 PDF 矢量图)
    </unfolded-io>
  </session>

  <section|3. 验证 SymPy 数学公式渲染>

  <\session|python|default>
    <\unfolded-io>
      \<gtr\>\<gtr\>\<gtr\>\ 
    <|unfolded-io>
      import sympy as sp
      x = sp.Symbol('x')
      sp.diff(sp.sin(x)**2, x)
    <|unfolded-io>
      <math|<with|font-family|rm|2*sin(x)*cos(x)>>
    </unfolded-io>
  </session>

  <section|4. 验证多行输入>

  <\session|python|default>
    <\unfolded-io>
      \<gtr\>\<gtr\>\<gtr\>\ 
    <|unfolded-io>
      a = 10
      b = 20
      a + b
    <|unfolded-io>
      30
    </unfolded-io>
  </session>

</body>

