<\body>
  <\section|Quiver 静态与交互式会话测试 (共 15 个用例)>
    \;
  </section>

  <\subsection|测试用例 1>
    \;
  </subsection>

  <\session|quiver|default>
    <\unfolded-io>
      quiver]\ 
    <|unfolded-io>
      A \\arrow[r, "f"] & B
    <|unfolded-io>
      <image|<tuple|<#|56.80893pt|16.88745pt||>>
    </unfolded-io>

    <\input|quiver]>
      \;
    </input>
  </session>

